<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>

    <!-- Custom entry point (Program.Main) so Velopack runs before WPF; disambiguates from
         the auto-generated App.g.cs Main. -->
    <StartupObject>FCAT.Program</StartupObject>

    <!-- Branding -->
    <ApplicationIcon>fcat.ico</ApplicationIcon>
    <AssemblyTitle>FCAT · Fleet Commander Assistance Tool</AssemblyTitle>
    <Product>FCAT</Product>
    <!-- Keep these together. FileVersion is what Windows shows in the file properties, and it
         drifted a release behind once already, which made a bug report impossible to place. -->
    <Version>0.20.0-beta</Version>
    <FileVersion>0.20.0.0</FileVersion>
    <AssemblyVersion>0.20.0.0</AssemblyVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Embedded so the window/taskbar icon resolves at runtime -->
    <Resource Include="fcat.ico" />
    <!-- 2D map layout (system positions per region), extracted once from Dotlan's published SVGs.
         Bundled so the map needs no network at all - see DotlanLayout.cs for the attribution note. -->
    <EmbeddedResource Include="Assets\dotlan-layout.json" />
    <!-- Real 3D system positions in light years, for jump-range work. Bundled because ESI serves
         one system per call and Hunt measures against every system in New Eden at once. -->
    <EmbeddedResource Include="Assets\system-space.json" />
    <!-- Every EVE skill type id. The dogma engine gives no bonus for a skill it was not told about,
         so "all V" has to be spelled out; embedded rather than fetched so fit numbers work offline. -->
    <EmbeddedResource Include="Assets\skills.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- The EVE static data the dogma engine calculates with, from the @eveshipfit/sde package. A
         loose file rather than an embedded resource on purpose: at 9MB it would land in every delta
         update, where as a file it only ships again when CCP's data actually changes. Refresh it on
         EVE patches; see RELEASING.md. -->
    <None Include="Assets\sde.dat" Link="sde.dat" CopyToOutputDirectory="PreserveNewest" />

    <!-- The dogma bridge: EVEShipFit's engine compiled to a native DLL (dogma-bridge/ in this repo).
         Build it there with cargo, release profile. Conditional, so the app still builds for anyone
         who has not, in which case fit statistics simply switch themselves off. -->
    <None Include="..\dogma-bridge\target\release\fcat_dogma.dll"
          Link="fcat_dogma.dll" CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('..\dogma-bridge\target\release\fcat_dogma.dll')" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.9" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Template file for contributors - not compiled -->
    <Compile Remove="AppSecrets.example.cs" />
    <None Include="AppSecrets.example.cs" />
  </ItemGroup>

</Project>
