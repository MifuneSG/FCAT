<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>

    <!-- Custom entry point (Program.Main) so Velopack runs before WPF; disambiguates from
         the auto-generated App.g.cs Main. -->
    <StartupObject>FCAT.Program</StartupObject>

    <!-- Branding -->
    <ApplicationIcon>fcat.ico</ApplicationIcon>
    <AssemblyTitle>FCAT · Fleet Commander Assistance Tool</AssemblyTitle>
    <Product>FCAT</Product>
    <!-- Keep these together. FileVersion is what Windows shows in the file properties, and it
         drifted a release behind once already, which made a bug report impossible to place. -->
    <Version>0.16.0-beta</Version>
    <FileVersion>0.16.0.0</FileVersion>
    <AssemblyVersion>0.16.0.0</AssemblyVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Embedded so the window/taskbar icon resolves at runtime -->
    <Resource Include="fcat.ico" />
    <!-- 2D map layout (system positions per region), extracted once from Dotlan's published SVGs.
         Bundled so the map needs no network at all - see DotlanLayout.cs for the attribution note. -->
    <EmbeddedResource Include="Assets\dotlan-layout.json" />
    <!-- Real 3D system positions in light years, for jump-range work. Bundled because ESI serves
         one system per call and Hunt measures against every system in New Eden at once. -->
    <EmbeddedResource Include="Assets\system-space.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.9" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Template file for contributors - not compiled -->
    <Compile Remove="AppSecrets.example.cs" />
    <None Include="AppSecrets.example.cs" />
  </ItemGroup>

</Project>
