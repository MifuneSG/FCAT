<UserControl x:Class="FCAT.Views.SessionLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FCAT.ViewModels"
             xmlns:svc="clr-namespace:FCAT.Services"
             xmlns:mdl="clr-namespace:FCAT.Models"
             d:DataContext="{d:DesignInstance vm:SessionLogViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>
        <!-- One ship line on the loss / kill lists -->
        <DataTemplate x:Key="BrLine" DataType="{x:Type svc:BattleReportLine}">
            <Grid Margin="0,0,0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Pilot}" Foreground="{StaticResource EveTextPrimary}"
                           FontFamily="{StaticResource FontUI}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                <TextBlock Grid.Column="1" Text="{Binding Ship}" Foreground="{StaticResource EveTextSecondary}"
                           FontFamily="{StaticResource FontUI}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                <TextBlock Grid.Column="2" Text="{Binding IskText}" Foreground="{StaticResource EveTextSecondary}"
                           FontFamily="{StaticResource FontMono}" FontSize="11" VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="34,22,34,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page header -->
        <Grid Grid.Row="0" Margin="2,0,2,14">
            <StackPanel VerticalAlignment="Bottom">
                <TextBlock Text="SESSION" Style="{StaticResource PageEyebrow}"/>
                <TextBlock Text="After-Action Report" Style="{StaticResource PageTitle}"/>
            </StackPanel>
            <Button Command="{Binding BackCommand}" Style="{StaticResource SecondaryButton}" Padding="13,7"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <TextBlock Text="← Back" FontFamily="{StaticResource FontUI}" FontSize="12"/>
            </Button>
        </Grid>

        <!-- Report card (flat) -->
        <Border Grid.Row="1" Background="{DynamicResource EvePanelBg}" BorderBrush="{DynamicResource EveHairline}"
                BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Body: battle report (left) timeline (right) -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="340"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="1.1*" MinWidth="320"/>
                    </Grid.ColumnDefinitions>

                    <!-- BATTLE REPORT -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="{DynamicResource EveRaisedBg}" BorderBrush="{DynamicResource EveHairline}"
                                BorderThickness="0,0,0,1" CornerRadius="8,0,0,0" Padding="16,10">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="BATTLE REPORT" Style="{StaticResource SectionLabel}"
                                               Foreground="{StaticResource EveTextSecondary}" VerticalAlignment="Center"/>
                                    <Border Margin="8,0,0,0" Padding="5,1" CornerRadius="3" VerticalAlignment="Center"
                                            BorderThickness="1" BorderBrush="{StaticResource EveAmber}" Background="#1f1a10">
                                        <Border.ToolTip>
                                            <ToolTip Padding="0" Background="Transparent" BorderThickness="0">
                                                <Border Background="{DynamicResource EvePanelBg}" BorderBrush="{DynamicResource EveHairlineStrong}"
                                                        BorderThickness="1" CornerRadius="6" Padding="14,12" MaxWidth="300">
                                                    <StackPanel>
                                                        <TextBlock Text="Work in progress" Foreground="{StaticResource EveAmber}"
                                                                   FontFamily="{StaticResource FontUI}" FontSize="13" FontWeight="SemiBold"/>
                                                        <TextBlock Text="The battle report is still being validated against live fights. Kills lag a few minutes and multi-system brawls can split across zKill windows - cross-check the Battle Report link before you trust the totals."
                                                                   Foreground="{StaticResource EveTextSecondary}" Margin="0,7,0,0"
                                                                   FontFamily="{StaticResource FontUI}" FontSize="12" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </Border>
                                            </ToolTip>
                                        </Border.ToolTip>
                                        <TextBlock Text="WIP" Foreground="{StaticResource EveAmber}"
                                                   FontFamily="{StaticResource FontUI}" FontSize="10" FontWeight="SemiBold"/>
                                    </Border>
                                    <TextBlock Text="{Binding Log.BattleReportSystem}" Foreground="{StaticResource EveGoldSoft}"
                                               FontFamily="{StaticResource FontUI}" FontSize="12" FontWeight="SemiBold"
                                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </StackPanel>
                                <Button Command="{Binding LoadReportCommand}" Style="{StaticResource GhostButton}" Padding="8,3"
                                        HorizontalAlignment="Right" IsEnabled="{Binding Log.HasBattleReport}"
                                        ToolTip="Re-pull kills from zKillboard (they lag a few minutes)">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconRefresh}" Style="{StaticResource ButtonIcon}"
                                              Width="12" Height="12" Stroke="{DynamicResource EveAccent}" Margin="0,0,6,0"/>
                                        <TextBlock Text="Refresh" FontFamily="{StaticResource FontUI}" FontSize="11"
                                                   Foreground="{DynamicResource EveAccent}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- no fight anchored yet -->
                        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24"
                                    Visibility="{Binding Log.HasBattleReport, Converter={StaticResource BoolToInvisibility}}">
                            <TextBlock Text="No fight recorded yet" Foreground="{StaticResource EveTextSecondary}"
                                       FontFamily="{StaticResource FontUI}" FontSize="13" HorizontalAlignment="Center"/>
                            <TextBlock Text="A battle report is anchored to the op's first loss." Foreground="{StaticResource EveTextDim}"
                                       FontFamily="{StaticResource FontUI}" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0" TextAlignment="Center"/>
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,14,16,10"
                                      Visibility="{Binding Log.HasBattleReport, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <!-- Totals -->
                                <Grid Visibility="{Binding HasReport, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="DESTROYED" Style="{StaticResource SectionLabel}"/>
                                        <TextBlock Text="{Binding Report.IskDestroyedText}" Foreground="{StaticResource EveGreen}"
                                                   FontFamily="{StaticResource FontUI}" FontSize="18" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                        <TextBlock Foreground="{StaticResource EveTextDim}" FontFamily="{StaticResource FontUI}" FontSize="11">
                                            <Run Text="{Binding Report.KillCount, Mode=OneWay}"/><Run Text=" kills"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="LOST" Style="{StaticResource SectionLabel}"/>
                                        <TextBlock Text="{Binding Report.IskLostText}" Foreground="{StaticResource EveCritical}"
                                                   FontFamily="{StaticResource FontUI}" FontSize="18" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                        <TextBlock Foreground="{StaticResource EveTextDim}" FontFamily="{StaticResource FontUI}" FontSize="11">
                                            <Run Text="{Binding Report.LossCount, Mode=OneWay}"/><Run Text=" losses"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="EFFICIENCY" Style="{StaticResource SectionLabel}"/>
                                        <TextBlock Text="{Binding Report.EfficiencyText}" Foreground="{StaticResource EveGoldSoft}"
                                                   FontFamily="{StaticResource FontUI}" FontSize="18" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                        <ProgressBar Value="{Binding Report.Efficiency, Mode=OneWay}" Maximum="100" Height="5"
                                                     Background="#3a1f22" Foreground="{StaticResource EveGreen}"
                                                     BorderThickness="0" Margin="0,6,8,0"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Losses (SRP) -->
                                <StackPanel Margin="0,16,0,0" Visibility="{Binding Report.HasLosses, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="LOSSES · SRP" Style="{StaticResource SectionLabel}" Margin="0,0,0,5"/>
                                    <ItemsControl ItemsSource="{Binding Report.Losses}" ItemTemplate="{StaticResource BrLine}"/>
                                </StackPanel>

                                <!-- Kills -->
                                <StackPanel Margin="0,16,0,0" Visibility="{Binding Report.HasKills, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="KILLS" Style="{StaticResource SectionLabel}" Margin="0,0,0,5"/>
                                    <ItemsControl ItemsSource="{Binding Report.Kills}" ItemTemplate="{StaticResource BrLine}"/>
                                </StackPanel>

                                <!-- Fleet attendance, read from the FC's own Alliance Auth. Hidden
                                     entirely without one. FCAT cannot create a FAT link and does not
                                     try: the connector is read-only. What it adds is the half auth
                                     cannot see, because only FCAT knows who was actually in fleet. -->
                                <StackPanel Margin="0,18,0,0"
                                            Visibility="{Binding HasFat, Converter={StaticResource BoolToVisibility}}">
                                    <Rectangle Height="1" Fill="{DynamicResource EveHairline}" Margin="0,0,0,12"/>
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="FLEET ATTENDANCE" Style="{StaticResource SectionLabel}"/>
                                        <TextBlock Text="{Binding FatStatus}" Foreground="{StaticResource EveTextDim}"
                                                   FontFamily="{StaticResource FontUI}" FontSize="11"
                                                   HorizontalAlignment="Right"/>
                                    </Grid>
                                    <TextBlock Text="{Binding FatFleet}" Foreground="{StaticResource EveTextSecondary}"
                                               FontFamily="{StaticResource FontUI}" FontSize="12" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding FatTracking}" FontFamily="{StaticResource FontUI}" FontSize="12"
                                               TextWrapping="Wrap" Margin="0,0,0,5"
                                               Visibility="{Binding FatTracking, Converter={StaticResource StringToVisibility}}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource EveCritical}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding FatHealthy}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource EveGreen}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding FatCounts}" FontFamily="{StaticResource FontMono}" FontSize="15" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource EveAmber}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding FatComplete}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource EveGreen}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <StackPanel Visibility="{Binding FatMissing.Count, Converter={StaticResource CountToVisibility}}">
                                        <TextBlock Text="Still to click" Foreground="{StaticResource EveAmber}"
                                                   FontFamily="{StaticResource FontUI}" FontSize="11" Margin="0,8,0,3"/>
                                        <ItemsControl ItemsSource="{Binding FatMissing}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" Foreground="{StaticResource EveTextSecondary}"
                                                               FontFamily="{StaticResource FontUI}" FontSize="12" Margin="0,1,0,0"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button Command="{Binding CopyFatLinkCommand}" Style="{StaticResource GhostButton}"
                                                Height="28" Padding="12,0" Margin="0,0,6,0"
                                                ToolTip="The link you already made on auth, ready to paste into fleet">
                                            <TextBlock Text="Copy link" FontFamily="{StaticResource FontUI}" FontSize="12"/>
                                        </Button>
                                        <Button Command="{Binding CopyFatMissingCommand}" Style="{StaticResource GhostButton}"
                                                Height="28" Padding="12,0"
                                                Visibility="{Binding FatMissing.Count, Converter={StaticResource CountToVisibility}}"
                                                ToolTip="The names still owing a click, ready to paste into fleet chat">
                                            <TextBlock Text="Copy names" FontFamily="{StaticResource FontUI}" FontSize="12"/>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>

                                <!-- What the alliance still owes for this op and recent ones. Read-only:
                                     approving a request and setting a payout stay on the website. -->
                                <StackPanel Margin="0,18,0,0"
                                            Visibility="{Binding HasSrp, Converter={StaticResource BoolToVisibility}}">
                                    <Rectangle Height="1" Fill="{DynamicResource EveHairline}" Margin="0,0,0,12"/>
                                    <TextBlock Text="SHIP REPLACEMENT" Style="{StaticResource SectionLabel}" Margin="0,0,0,6"/>
                                    <ItemsControl ItemsSource="{Binding SrpFleets}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type mdl:AaSrpFleet}">
                                                <Grid Margin="0,0,0,7">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource EveTextSecondary}"
                                                                   FontFamily="{StaticResource FontUI}" FontSize="12"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Code}" Foreground="{StaticResource EveTextDim}"
                                                                   FontFamily="{StaticResource FontMono}" FontSize="11"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                        <TextBlock Text="{Binding CostText}" Foreground="{StaticResource EveTextSecondary}"
                                                                   FontFamily="{StaticResource FontMono}" FontSize="12"
                                                                   HorizontalAlignment="Right"/>
                                                        <TextBlock Text="{Binding PendingText}" FontFamily="{StaticResource FontUI}" FontSize="11"
                                                                   HorizontalAlignment="Right">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{StaticResource EveTextDim}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasPending}" Value="True">
                                                                            <Setter Property="Foreground" Value="{StaticResource EveAmber}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <TextBlock Text="{Binding ReportStatus}" Foreground="{StaticResource EveTextDim}"
                                           FontFamily="{StaticResource FontUI}" FontSize="11" Margin="0,14,0,0" TextWrapping="Wrap"
                                           Visibility="{Binding ReportStatus, Converter={StaticResource StringToVisibility}}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- vertical divider -->
                    <Rectangle Grid.Column="1" Width="1" Fill="{DynamicResource EveHairline}"/>

                    <!-- TIMELINE -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="{DynamicResource EveRaisedBg}" BorderBrush="{DynamicResource EveHairline}"
                                BorderThickness="0,0,0,1" CornerRadius="0,8,0,0" Padding="16,10">
                            <Grid>
                                <TextBlock Text="SESSION TIMELINE" Style="{StaticResource SectionLabel}"
                                           Foreground="{StaticResource EveTextSecondary}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Log.Summary}" FontFamily="{StaticResource FontMono}" FontSize="11"
                                           Foreground="{StaticResource EveTextDim}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Empty state -->
                        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="{Binding Log.Entries.Count, Converter={StaticResource CountToInvisibility}}">
                            <TextBlock Text="No events recorded yet" Foreground="{StaticResource EveTextSecondary}"
                                       FontFamily="{StaticResource FontUI}" FontSize="13" HorizontalAlignment="Center"/>
                            <TextBlock Text="Alerts and fleet changes are logged here while a fleet is monitored." Foreground="{StaticResource EveTextDim}"
                                       FontFamily="{StaticResource FontUI}" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Timeline: dense monospace rows -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,4,0,4">
                            <ItemsControl ItemsSource="{Binding Log.Entries}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type svc:AarEntry}">
                                        <Border Padding="16,5" BorderBrush="{DynamicResource EveHairlineSoft}" BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="66"/>
                                                    <ColumnDefinition Width="104"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Time, StringFormat=HH:mm:ss}"
                                                           FontFamily="{StaticResource FontMono}" FontSize="12"
                                                           Foreground="{StaticResource EveTextDim}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Category}"
                                                           FontFamily="{StaticResource FontMono}" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{StaticResource EveGold}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Text}"
                                                           FontFamily="{StaticResource FontUI}" FontSize="12.5"
                                                           Foreground="{StaticResource EveTextPrimary}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <!-- Footer bar -->
                <Border Grid.Row="1" Background="{DynamicResource EveRaisedBg}" BorderBrush="{DynamicResource EveHairline}"
                        BorderThickness="0,1,0,0" CornerRadius="0,0,8,8" Padding="16,10">
                    <Grid>
                        <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource EveAccent}"
                                   FontFamily="{StaticResource FontUI}" FontSize="11" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Command="{Binding OpenBattleReportCommand}" Style="{StaticResource SecondaryButton}" Height="32" Padding="13,0" Margin="0,0,8,0"
                                    Visibility="{Binding Log.HasBattleReport, Converter={StaticResource BoolToVisibility}}"
                                    ToolTip="Open the zKillboard battle report for this fight (system + time)">
                                <TextBlock Text="Battle Report ↗" Foreground="{DynamicResource EveAccent}" FontFamily="{StaticResource FontUI}" FontSize="12"/>
                            </Button>
                            <Button Command="{Binding ClearCommand}" Style="{StaticResource SecondaryButton}" Height="32" Padding="14,0" Margin="0,0,8,0">
                                <TextBlock Text="Clear" FontFamily="{StaticResource FontUI}" FontSize="12"/>
                            </Button>
                            <Button Command="{Binding CopyCommand}" Style="{StaticResource SecondaryButton}" Height="32" Padding="14,0" Margin="0,0,8,0"
                                    ToolTip="Copy the AAR as plain text, pastes cleanly into Discord">
                                <TextBlock Text="Copy" FontFamily="{StaticResource FontUI}" FontSize="12"/>
                            </Button>
                            <Button Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" Height="32" Padding="16,0">
                                <TextBlock Text="Save .md" FontFamily="{StaticResource FontUI}" FontSize="12" FontWeight="SemiBold"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
