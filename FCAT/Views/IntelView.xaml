<UserControl x:Class="FCAT.Views.IntelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FCAT.ViewModels"
             xmlns:models="clr-namespace:FCAT.Models"
             xmlns:v="clr-namespace:FCAT.Views"
             d:DataContext="{d:DesignInstance vm:IntelViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Loaded="OnLoaded" Unloaded="OnUnloaded">

    <UserControl.Resources>
        <!-- Compact segmented filter button for the intel feed -->
        <Style x:Key="FilterBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="11,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page header -->
        <StackPanel Grid.Row="0" Margin="34,24,34,16">
            <TextBlock Text="INTELLIGENCE" Style="{StaticResource PageEyebrow}"/>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Intel Tools" Style="{StaticResource PageTitle}"/>
                <v:HintIcon Margin="8,6,0,0" Text="Minimap, scan pane, hunting tool and your intel channel feed.&#xA;&#xA;Kills and jumps come from CCP's hourly dumps. Read them as where things have been happening, not what is happening right now.&#xA;&#xA;The intel feed and anything you paste in are the only live parts."/>
            </StackPanel>
        </StackPanel>

        <!-- Main: map / d-scan on the left, intel feed as a full-height column on the right. The
             feed used to be a wide strip across the bottom, which stole height from the map and
             left the map's own row too wide - a feed reads better as a tall column anyway. -->
        <Grid Grid.Row="1" Margin="34,0,34,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Pane switcher -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Border CornerRadius="6" Background="#0f1622" BorderBrush="{DynamicResource EveHairlineStrong}" BorderThickness="1"
                            Padding="3" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource FilterBtn}" Height="30" Padding="18,0" Command="{Binding SetPaneCommand}" CommandParameter="Map">
                                <TextBlock Text="MiniMap" FontFamily="{StaticResource FontUI}" FontSize="12" FontWeight="SemiBold">
                                    <TextBlock.Style><Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource EveTextDim}"/>
                                        <Style.Triggers><DataTrigger Binding="{Binding IsMapPane}" Value="True"><Setter Property="Foreground" Value="{DynamicResource EveAccent}"/></DataTrigger></Style.Triggers>
                                    </Style></TextBlock.Style>
                                </TextBlock>
                            </Button>
                            <Button Style="{StaticResource FilterBtn}" Height="30" Padding="18,0" Command="{Binding SetPaneCommand}" CommandParameter="Dscan">
                                <TextBlock Text="D-scan" FontFamily="{StaticResource FontUI}" FontSize="12" FontWeight="SemiBold">
                                    <TextBlock.Style><Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource EveTextDim}"/>
                                        <Style.Triggers><DataTrigger Binding="{Binding IsDscanPane}" Value="True"><Setter Property="Foreground" Value="{DynamicResource EveAccent}"/></DataTrigger></Style.Triggers>
                                    </Style></TextBlock.Style>
                                </TextBlock>
                            </Button>
                            <Button Style="{StaticResource FilterBtn}" Height="30" Padding="18,0" Command="{Binding SetPaneCommand}" CommandParameter="Hunt">
                                <TextBlock Text="Hunt" FontFamily="{StaticResource FontUI}" FontSize="12" FontWeight="SemiBold">
                                    <TextBlock.Style><Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource EveTextDim}"/>
                                        <Style.Triggers><DataTrigger Binding="{Binding IsHuntPane}" Value="True"><Setter Property="Foreground" Value="{DynamicResource EveAccent}"/></DataTrigger></Style.Triggers>
                                    </Style></TextBlock.Style>
                                </TextBlock>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Where you are + controls. This header belongs to the minimap - the scan and
                         hunt panes carry their own, and Hunt measures from a system you may have
                         picked rather than the one you're sitting in. -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Visibility="{Binding ShowMapHeader, Converter={StaticResource BoolToVisibility}}">
                        <!-- Looking at somewhere other than your own system is a real mode, so it gets
                             a real banner - the old quiet label read as an accident. -->
                        <Border CornerRadius="5" Background="#2a2140" BorderBrush="{DynamicResource EveAccent}" BorderThickness="1"
                                Padding="9,3" Margin="0,0,10,0" VerticalAlignment="Center"
                                Visibility="{Binding System.IsPinned, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="VIEWING" Foreground="{DynamicResource EveAccent}" FontFamily="{StaticResource FontUI}"
                                           FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBlock Text="{Binding System.SystemName}" Foreground="{StaticResource EveTextPrimary}"
                                           FontFamily="{StaticResource FontUI}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Button Command="{Binding System.ReturnToCurrentCommand}" Style="{StaticResource GhostButton}"
                                        Padding="7,1" Margin="9,0,0,0" ToolTip="Snap back to the system you're actually in">
                                    <TextBlock Text="← back to you" Foreground="{DynamicResource EveAccent}" FontFamily="{StaticResource FontUI}" FontSize="11"/>
                                </Button>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                    Visibility="{Binding System.IsPinned, Converter={StaticResource BoolToInvisibility}}">
                            <TextBlock Text="{Binding System.SystemName}" Foreground="{StaticResource EveTextPrimary}"
                                       FontFamily="{StaticResource FontUI}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding System.LocationLine}" Foreground="{StaticResource EveTextDim}"
                                       FontFamily="{StaticResource FontUI}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>

                        <Button Command="{Binding Shell.ToggleMapOverlayCommand}" Style="{StaticResource GhostButton}" Padding="9,3" Margin="10,0,0,0"
                                ToolTip="Show the map over your game as an always-on-top window">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="12" Height="12" Margin="0,0,6,0">
                                    <Path.Style><Style TargetType="Path" BasedOn="{StaticResource ButtonIcon}">
                                        <Setter Property="Data"   Value="{StaticResource IconOverlay}"/>
                                        <Setter Property="Stroke" Value="{StaticResource EveTextDim}"/>
                                        <Style.Triggers><DataTrigger Binding="{Binding Shell.MapOverlayEnabled}" Value="True">
                                            <Setter Property="Stroke" Value="{DynamicResource EveAccent}"/>
                                        </DataTrigger></Style.Triggers>
                                    </Style></Path.Style>
                                </Path>
                                <TextBlock FontFamily="{StaticResource FontUI}" FontSize="11" VerticalAlignment="Center">
                                    <TextBlock.Style><Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Overlay"/>
                                        <Setter Property="Foreground" Value="{StaticResource EveTextDim}"/>
                                        <Style.Triggers><DataTrigger Binding="{Binding Shell.MapOverlayEnabled}" Value="True">
                                            <Setter Property="Text" Value="Overlay ON"/>
                                            <Setter Property="Foreground" Value="{DynamicResource EveAccent}"/>
                                        </DataTrigger></Style.Triggers>
                                    </Style></TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding Shell.ToggleMapOverlayLockCommand}" Style="{StaticResource GhostButton}" Padding="9,3" Margin="4,0,0,0"
                                ToolTip="Lock makes the map overlay click-through so it won't steal clicks from the game"
                                Visibility="{Binding Shell.MapOverlayEnabled, Converter={StaticResource BoolToVisibility}}">
                            <Path>
                                <Path.Style><Style TargetType="Path" BasedOn="{StaticResource ButtonIcon}">
                                    <Setter Property="Data"   Value="{StaticResource IconLockOpen}"/>
                                    <Setter Property="Stroke" Value="{DynamicResource EveAmber}"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding Shell.MapOverlayLocked}" Value="True">
                                        <Setter Property="Data"   Value="{StaticResource IconLockShut}"/>
                                        <Setter Property="Stroke" Value="{StaticResource EveTextDim}"/>
                                    </DataTrigger></Style.Triggers>
                                </Style></Path.Style>
                            </Path>
                        </Button>
                        <Button Command="{Binding System.RefreshCommand}" Style="{StaticResource GhostButton}" Padding="8,3" Margin="4,0,0,0" ToolTip="Refresh">
                            <Path Style="{StaticResource ButtonIcon}" Data="{StaticResource IconRefresh}"
                                  Stroke="{DynamicResource EveAccent}"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- All three panes share the content cell -->
                <Grid Grid.Row="1">

            <!-- MAP PANE - constellation schematic (scroll to zoom, drag to pan) + the overview rail beside it -->
            <Border Style="{StaticResource Card}" Visibility="{Binding IsMapPane, Converter={StaticResource BoolToVisibility}}">
                <Grid Margin="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="170"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                    <!-- No panel behind the map on purpose. It used to sit in its own dark rounded
                         box, which read as a box inside the card inside the page - the map should
                         just sit on the app's background the way a star map sits on space. -->
                    <Border Background="Transparent" ClipToBounds="True">
                        <Grid x:Name="Viewport" Background="Transparent" ClipToBounds="True"
                              SizeChanged="OnViewportSizeChanged">
                            <!-- Minimap: fixed scale, centred on you, cropped at the edges. The
                                 translate below pins the current system (0,0) to the middle. -->
                            <Grid x:Name="MapRoot" HorizontalAlignment="Left" VerticalAlignment="Top">
                                <Grid.RenderTransform>
                                    <TranslateTransform x:Name="MapCentre"/>
                                </Grid.RenderTransform>

                                <ItemsControl ItemsSource="{Binding System.MapLinks}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:MapLink}">
                                            <Line X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}" StrokeThickness="1.5">
                                                <Line.Style>
                                                    <Style TargetType="Line">
                                                        <Setter Property="Stroke" Value="{DynamicResource EveHairlineStrong}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsExit}" Value="True">
                                                                <Setter Property="Stroke" Value="{DynamicResource EveGreen}"/>
                                                                <Setter Property="StrokeDashArray" Value="3 2"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Line.Style>
                                            </Line>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <ItemsControl ItemsSource="{Binding System.MapNodes}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding NodeLeft}"/>
                                            <Setter Property="Canvas.Top"  Value="{Binding NodeTop}"/>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:MapNode}">
                                            <Grid Width="72" HorizontalAlignment="Center" Background="Transparent" Cursor="Hand"
                                                  Tag="{Binding DataContext.System, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  MouseLeftButtonUp="OnNodeClick">
                                                <Grid.ToolTip>
                                                    <StackPanel MaxWidth="260">
                                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource EveTextPrimary}" FontFamily="{StaticResource FontUI}" FontSize="12" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding SovLabel}" Foreground="{StaticResource EveGoldSoft}" FontFamily="{StaticResource FontUI}" FontSize="11" Margin="0,2,0,0"
                                                                   Visibility="{Binding SovLabel, Converter={StaticResource StringToVisibility}}"/>
                                                        <TextBlock Text="{Binding Stats}" Foreground="{StaticResource EveTextSecondary}" FontFamily="{StaticResource FontUI}" FontSize="11" Margin="0,3,0,0"/>
                                                        <TextBlock Text="{Binding AltTip}" Foreground="{StaticResource EveGoldSoft}" FontFamily="{StaticResource FontUI}" FontSize="11" Margin="0,3,0,0"
                                                                   Visibility="{Binding HasAlt, Converter={StaticResource BoolToVisibility}}"/>
                                                        <TextBlock Text="{Binding StructureTip}" FontFamily="{StaticResource FontUI}" FontSize="11" Margin="0,3,0,0"
                                                                   Visibility="{Binding HasStructure, Converter={StaticResource BoolToVisibility}}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{StaticResource EveAmber}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding CanShelter}" Value="True">
                                                                            <Setter Property="Foreground" Value="{StaticResource EveGreen}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Text="Click to focus · right-click for Dotlan / zKillboard" Foreground="{StaticResource EveTextDim}" FontFamily="{StaticResource FontUI}" FontSize="11" Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                </Grid.ToolTip>
                                                <Grid.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Open in Dotlan"
                                                                  Command="{Binding PlacementTarget.Tag.OpenDotlanCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding}"/>
                                                        <MenuItem Header="Open on zKillboard"
                                                                  Command="{Binding PlacementTarget.Tag.OpenZkillCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding}"/>
                                                    </ContextMenu>
                                                </Grid.ContextMenu>

                                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Grid Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <!-- soft outer glow, so a system reads as a body rather than a flat pip -->
                                                        <Ellipse Width="24" Height="24" IsHitTestVisible="False">
                                                            <Ellipse.Style>
                                                                <Style TargetType="Ellipse">
                                                                    <Setter Property="Fill" Value="Transparent"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Hot}" Value="True">
                                                                            <Setter Property="Fill">
                                                                                <Setter.Value>
                                                                                    <RadialGradientBrush>
                                                                                        <GradientStop Color="#66E2574C" Offset="0"/>
                                                                                        <GradientStop Color="#00E2574C" Offset="1"/>
                                                                                    </RadialGradientBrush>
                                                                                </Setter.Value>
                                                                            </Setter>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                            <Setter Property="Fill">
                                                                                <Setter.Value>
                                                                                    <RadialGradientBrush>
                                                                                        <GradientStop Color="#77A98CE0" Offset="0"/>
                                                                                        <GradientStop Color="#00A98CE0" Offset="1"/>
                                                                                    </RadialGradientBrush>
                                                                                </Setter.Value>
                                                                            </Setter>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Ellipse.Style>
                                                        </Ellipse>

                                                        <Ellipse x:Name="PulseRing" Width="21" Height="21"
                                                                 Stroke="{DynamicResource EveCritical}" StrokeThickness="2"
                                                                 Opacity="0" IsHitTestVisible="False"/>

                                                        <!-- thin ring marks the system on screen -->
                                                        <Ellipse Width="19" Height="19" Stroke="{DynamicResource EveAccent}" StrokeThickness="1.5" Opacity="0.7"
                                                                 Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibility}}"/>

                                                        <!-- and a gold ring keeps marking where you ACTUALLY are while you explore -->
                                                        <Ellipse Width="19" Height="19" Stroke="{StaticResource EveGoldSoft}" StrokeThickness="2" StrokeDashArray="2 1.5"
                                                                 Visibility="{Binding IsHome, Converter={StaticResource BoolToVisibility}}"/>

                                                        <Ellipse Width="11" Height="11" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <Ellipse.Style>
                                                                <Style TargetType="Ellipse">
                                                                    <Setter Property="Fill" Value="#4A5468"/>
                                                                    <Setter Property="Stroke" Value="#6E7A90"/>
                                                                    <Setter Property="StrokeThickness" Value="1"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Hot}" Value="True">
                                                                            <Setter Property="Fill" Value="{DynamicResource EveCritical}"/>
                                                                            <Setter Property="Stroke" Value="#F09B93"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsExit}" Value="True">
                                                                            <Setter Property="Fill" Value="#0F2A24"/>
                                                                            <Setter Property="Stroke" Value="{DynamicResource EveGreen}"/>
                                                                            <Setter Property="StrokeThickness" Value="2"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                            <Setter Property="Fill" Value="{DynamicResource EveAccent}"/>
                                                                            <Setter Property="Stroke" Value="#D9C8F5"/>
                                                                            <Setter Property="StrokeThickness" Value="1.5"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Ellipse.Style>
                                                        </Ellipse>

                                                        <!-- Kill count, tucked onto the node's shoulder. The old margin cleared the
                                                             19px ring entirely, so the badge read as a loose dot floating beside the
                                                             system rather than as that system's count. -->
                                                        <Border CornerRadius="7" Background="{DynamicResource EveCritical}" MinWidth="14" Height="14" Padding="3,0"
                                                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-3,-6,0"
                                                                Visibility="{Binding Hot, Converter={StaticResource BoolToVisibility}}">
                                                            <TextBlock Text="{Binding KillBadge}" Foreground="#1a0f0f" FontFamily="{StaticResource FontUI}" FontSize="10" FontWeight="Bold"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </Grid>

                                                    <!-- A friendly structure in this system. Left shoulder, where nothing else
                                                         sits: the kill badge owns the right and alts own the top. Green when the
                                                         fleet could actually dock or tether, amber when the structure is there but
                                                         reinforced, unfuelled or still going up - which an FC needs to see, because
                                                         "there is a Fortizar here" and "you can hide in it" are different facts. -->
                                                    <Path Width="11" Height="11" Stretch="Uniform" StrokeThickness="2"
                                                          StrokeLineJoin="Round" Data="{StaticResource IconStructure}"
                                                          HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-3,0,0,0"
                                                          IsHitTestVisible="False"
                                                          Visibility="{Binding HasStructure, Converter={StaticResource BoolToVisibility}}">
                                                        <Path.Style>
                                                            <Style TargetType="Path">
                                                                <Setter Property="Stroke" Value="{StaticResource EveAmber}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding CanShelter}" Value="True">
                                                                        <Setter Property="Stroke" Value="{StaticResource EveGreen}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Path.Style>
                                                    </Path>

                                                    <!-- Where one of your own alts is sitting. Gold, above the dot, so it reads as
                                                         yours rather than as another piece of intel about the system. Negative
                                                         margin keeps it out of the layout box, so the dot stays centred on the
                                                         gate links. -->
                                                    <Border CornerRadius="3" Background="#33120E02" BorderBrush="{StaticResource EveGoldSoft}"
                                                            BorderThickness="1" Height="13" Padding="4,0"
                                                            HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-16,0,0"
                                                            Visibility="{Binding HasAlt, Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock Text="{Binding AltBadge}" Foreground="{StaticResource EveGoldSoft}"
                                                                   FontFamily="{StaticResource FontUI}" FontSize="10" FontWeight="SemiBold"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>

                                                    <TextBlock Text="{Binding Name}" FontFamily="{StaticResource FontUI}" FontSize="10"
                                                               HorizontalAlignment="Center" TextAlignment="Center"
                                                               VerticalAlignment="Bottom" Margin="0,0,0,-16"
                                                               TextTrimming="CharacterEllipsis">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{StaticResource EveTextSecondary}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Hot}" Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource EveTextPrimary}"/>
                                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsExit}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource EveGreen}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource EveAccent}"/>
                                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Pulse}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard x:Name="PulseSb">
                                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                                <DoubleAnimation Storyboard.TargetName="PulseRing" Storyboard.TargetProperty="Opacity"
                                                                                 From="0.0" To="0.75" Duration="0:0:0.9"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions>
                                                        <StopStoryboard BeginStoryboardName="PulseSb"/>
                                                    </DataTrigger.ExitActions>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Credit for the layout - it's Wollari's work, fetched per-install, not shipped -->
                    <TextBlock Text="map layout © Wollari · dotlan.net" Foreground="{StaticResource EveTextDim}"
                               FontFamily="{StaticResource FontUI}" FontSize="10" Opacity="0.6"
                               HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10,0,0,4"
                               Visibility="{Binding System.UsingDotlanLayout, Converter={StaticResource BoolToVisibility}}"/>
                    </Grid>

                    <!-- FC RAIL - the three things an FC reads a map for:
                         what is in range to fight, what content is nearby, and how to leave. -->
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding System.HasResult, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <!-- this system, at a glance -->
                            <WrapPanel Margin="0,2,0,8">
                                <StackPanel Width="54" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding System.ShipKills}" Foreground="{DynamicResource EveCritical}" FontFamily="{StaticResource FontUI}" FontSize="18" FontWeight="SemiBold"/>
                                    <TextBlock Text="KILLS" Foreground="{StaticResource EveTextDim}" FontFamily="{StaticResource FontUI}" FontSize="11"/>
                                </StackPanel>
                                <StackPanel Width="54" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding System.NpcKills}" Foreground="{DynamicResource EveAmber}" FontFamily="{StaticResource FontUI}" FontSize="18" FontWeight="SemiBold"/>
                                    <TextBlock Text="NPC" Foreground="{StaticResource EveTextDim}" FontFamily="{StaticResource FontUI}" FontSize="11"/>
                                </StackPanel>
                                <StackPanel Width="54" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding System.SysJumps}" Foreground="{StaticResource EveTextSecondary}" FontFamily="{StaticResource FontUI}" FontSize="18" FontWeight="SemiBold"/>
                                    <TextBlock Text="JUMPS" Foreground="{StaticResource EveTextDim}" FontFamily="{StaticResource FontUI}" FontSize="11"/>
                                </StackPanel>
                                <StackPanel Width="54" Margin="0,0,0,8" ToolTip="NPC stations only - ESI does not list player citadels. Friendly ones appear beside this when your auth is connected.">
                                    <TextBlock Text="{Binding System.StationCount}" Foreground="{StaticResource EveTextSecondary}" FontFamily="{StaticResource FontUI}" FontSize="18" FontWeight="SemiBold"/>
                                    <TextBlock Text="STATIONS" Foreground="{StaticResource EveTextDim}" FontFamily="{StaticResource FontUI}" FontSize="11"/>
                                </StackPanel>

                                <!-- The alliance's own structures here, from Alliance Auth. Hidden
                                     entirely without it, so it reads as "0 STATIONS" alone for
                                     everyone else. A plain count beside the NPC one, because they
                                     are different things and folding them together would hide that
                                     ESI cannot see citadels at all. The colour is the only extra:
                                     green when at least one could actually be docked in, amber when
                                     they are all reinforced, unfuelled or still going up. -->
                                <StackPanel Width="78" Margin="0,0,0,8"
                                            Visibility="{Binding System.HasFriendly, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel.ToolTip>
                                        <StackPanel MaxWidth="280">
                                            <TextBlock Text="Your alliance's structures in this system" Foreground="{StaticResource EveTextPrimary}"
                                                       FontFamily="{StaticResource FontUI}" FontSize="12" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding System.FriendlyTip}" Foreground="{StaticResource EveTextSecondary}"
                                                       FontFamily="{StaticResource FontUI}" FontSize="11" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </StackPanel.ToolTip>
                                    <TextBlock Text="{Binding System.FriendlyCount}" FontFamily="{StaticResource FontUI}" FontSize="18" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource EveGreen}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding System.FriendlyDocking}" Value="0">
                                                        <Setter Property="Foreground" Value="{StaticResource EveAmber}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding System.FriendlyLabel}" Foreground="{StaticResource EveTextDim}"
                                               FontFamily="{StaticResource FontUI}" FontSize="11"/>
                                </StackPanel>

                            </WrapPanel>

                            <!-- Sov holder for the system on screen -->
                            <StackPanel Margin="0,0,0,8" Visibility="{Binding System.HasSov, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="SOV" Style="{StaticResource SectionLabel}" Margin="0,0,0,2"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding System.SovTicker}" Foreground="{DynamicResource EveAccent}" FontFamily="{StaticResource FontMono}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,7,0"
                                               Visibility="{Binding System.SovTicker, Converter={StaticResource StringToVisibility}}"/>
                                    <TextBlock Text="{Binding System.SovHolder}" Foreground="{StaticResource EveTextSecondary}" FontFamily="{StaticResource FontUI}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- 1. WHAT IS IN RANGE TO FIGHT (measured from where the FC is, not
                                 from a system they've clicked to explore) -->
                            <TextBlock Foreground="{DynamicResource EveAccent}" FontFamily="{StaticResource FontUI}" FontSize="10" Margin="0,4,0,0"
                                       Visibility="{Binding System.RangeOriginName, Converter={StaticResource StringToVisibility}}">
                                <Run Text="range measured from "/><Run Text="{Binding System.RangeOriginName, Mode=OneWay}" FontWeight="SemiBold"/>
                            </TextBlock>
                            <Grid Margin="0,4,0,6">
                                <TextBlock Text="IN RANGE" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
                                <Button Command="{Binding System.CycleRangeCommand}" Style="{StaticResource GhostButton}"
                                        Padding="7,1" HorizontalAlignment="Right" ToolTip="How far out to look">
                                    <TextBlock Foreground="{DynamicResource EveAccent}" FontFamily="{StaticResource FontUI}" FontSize="10">
                                        <Run Text="{Binding System.RangeJumps, Mode=OneWay}"/><Run Text=" jumps"/>
                                    </TextBlock>
                                </Button>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding System.InRange}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:RangeRow}">
                                        <Grid Margin="0,0,2,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding JumpsText}" Foreground="{StaticResource EveTextDim}"
                                                       FontFamily="{StaticResource FontMono}" FontSize="10" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{StaticResource EveTextSecondary}"
                                                       FontFamily="{StaticResource FontUI}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <Border Grid.Column="2" CornerRadius="7" Background="{DynamicResource EveCritical}" MinWidth="15" Height="15" Padding="4,0">
                                                <TextBlock Text="{Binding KillsText}" Foreground="#1a0f0f" FontFamily="{StaticResource FontUI}" FontSize="10" FontWeight="Bold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Nothing fighting in range." Foreground="{StaticResource EveTextDim}"
                                       FontFamily="{StaticResource FontUI}" FontSize="11" FontStyle="Italic" Margin="0,0,0,2"
                                       Visibility="{Binding System.HasInRange, Converter={StaticResource BoolToInvisibility}}"/>

                            <Rectangle Height="1" Fill="{DynamicResource EveHairline}" Margin="0,10,0,10"/>

                            <!-- 2. WHAT CONTENT IS AROUND ME -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="CONTENT" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
                                <v:HintIcon Text="Ratting, sov timers, incursions and faction war around you. Ratting ranks on the rise in NPC kills rather than the total, because a big total just means it's a ratting pocket. A rising one means someone is out there now."/>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding System.Content}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ContentRow}">
                                        <Grid Margin="0,0,2,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding JumpsText}" Foreground="{StaticResource EveTextDim}"
                                                       FontFamily="{StaticResource FontMono}" FontSize="10" VerticalAlignment="Top" Margin="0,1,0,0"/>
                                            <!-- system first, then what's happening there - you scan
                                                 down the system column, not the activity column -->
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource EveTextSecondary}"
                                                           FontFamily="{StaticResource FontUI}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding What}" FontFamily="{StaticResource FontUI}" FontSize="10" FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource EveAmber}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Kind}" Value="Incursion"><Setter Property="Foreground" Value="{DynamicResource EveCritical}"/></DataTrigger>
                                                                    <DataTrigger Binding="{Binding Kind}" Value="Ratting"><Setter Property="Foreground" Value="{StaticResource EveGoldSoft}"/></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Detail}" Foreground="{StaticResource EveTextDim}"
                                                               FontFamily="{StaticResource FontUI}" FontSize="10" Margin="5,0,0,0"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Quiet around here." Foreground="{StaticResource EveTextDim}"
                                       FontFamily="{StaticResource FontUI}" FontSize="11" FontStyle="Italic"
                                       Visibility="{Binding System.HasContent, Converter={StaticResource BoolToInvisibility}}"/>

                            <Rectangle Height="1" Fill="{DynamicResource EveHairline}" Margin="0,10,0,10"/>

                            <!-- 3. HOW DO I GET OUT -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="ESCAPES" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
                                <v:HintIcon Text="Ways out of the constellation, quietest first. A gate with a fight on it isn't an escape, so kills push it down."/>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding System.Escapes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:EscapeRow}">
                                        <Grid Margin="0,0,2,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding JumpsText}" Foreground="{StaticResource EveTextDim}"
                                                       FontFamily="{StaticResource FontMono}" FontSize="10" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontFamily="{StaticResource FontUI}" FontSize="11"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource EveGreen}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsHot}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource EveTextSecondary}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Grid.Column="2" Text="{Binding Status}" FontFamily="{StaticResource FontUI}" FontSize="10" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource EveGreen}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsHot}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource EveCritical}"/>
                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="No exits found." Foreground="{StaticResource EveTextDim}"
                                       FontFamily="{StaticResource FontUI}" FontSize="11" FontStyle="Italic"
                                       Visibility="{Binding System.HasEscapes, Converter={StaticResource BoolToInvisibility}}"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- SCAN PANEL (d-scan / local paste) -->
            <Border Style="{StaticResource Card}" Visibility="{Binding IsDscanPane, Converter={StaticResource BoolToVisibility}}">
                <Grid Margin="20,18,20,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="SCAN" Style="{StaticResource SectionLabel}" Margin="0,0,0,10"/>

                    <Border Grid.Row="1" Background="#0f1622" BorderBrush="{DynamicResource EveHairlineStrong}" BorderThickness="1" CornerRadius="7" Height="120">
                        <TextBox Text="{Binding Scan.Input, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource EveTextPrimary}" CaretBrush="{DynamicResource EveAccent}" FontFamily="{StaticResource FontMono}" FontSize="11"
                                 Padding="10,8" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                    </Border>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Command="{Binding Scan.ClearCommand}" Style="{StaticResource GhostButton}" Padding="14,0" Height="34" Margin="0,0,8,0">
                            <TextBlock Text="Clear" FontFamily="{StaticResource FontUI}" FontSize="12"/>
                        </Button>
                        <Button Command="{Binding Scan.CopySummaryCommand}" Style="{StaticResource SecondaryButton}" Padding="14,0" Height="34" Margin="0,0,8,0">
                            <TextBlock Text="Copy text" FontFamily="{StaticResource FontUI}" FontSize="12"/>
                        </Button>
                        <Button Command="{Binding Scan.CopyImageCommand}" Style="{StaticResource SecondaryButton}" Padding="14,0" Height="34" Margin="0,0,8,0"
                                ToolTip="Copy the scan as a picture, ready to paste straight into Discord">
                            <TextBlock Text="Copy image" FontFamily="{StaticResource FontUI}" FontSize="12"/>
                        </Button>
                        <Button Command="{Binding Scan.AnalyzeCommand}" Style="{StaticResource PrimaryButton}" Padding="20,0" Height="34">
                            <TextBlock Text="Analyze" FontFamily="{StaticResource FontUI}" FontSize="12" FontWeight="SemiBold"/>
                        </Button>
                    </StackPanel>

                    <TextBlock Grid.Row="3" Text="{Binding Scan.Summary}" Foreground="{StaticResource EveTextDim}" FontFamily="{StaticResource FontUI}" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0"/>

                    <ItemsControl Grid.Row="4" ItemsSource="{Binding Scan.RoleBreakdown}" Margin="0,14,0,0" Visibility="{Binding Scan.HasResult, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:FleetStat}">
                                <StackPanel Orientation="Horizontal" Margin="0,0,20,8" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Count}" Foreground="{Binding Color}" FontFamily="{StaticResource FontUI}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Label}" Foreground="{StaticResource EveTextDim}" FontFamily="{StaticResource FontUI}" FontSize="10" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid Grid.Row="5" Margin="0,8,0,0"
                          Visibility="{Binding Scan.HasResult, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="238"/>
                        </Grid.ColumnDefinitions>

                        <!-- Primary board: hulls on a d-scan, alliances on a local -->
                        <Border Grid.Column="0" BorderBrush="{DynamicResource EveHairline}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="SHIPS" Style="{StaticResource SectionLabel}" Margin="0,0,0,8"
                                               Visibility="{Binding Scan.IsShipResult, Converter={StaticResource BoolToVisibility}}"/>
                                    <ItemsControl ItemsSource="{Binding Scan.Ships}"
                                                  Visibility="{Binding Scan.IsShipResult, Converter={StaticResource BoolToVisibility}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:DScanShip}">
                                                <Grid Margin="0,0,6,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="44"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding CountText}" Foreground="{StaticResource EveTextPrimary}" FontFamily="{StaticResource FontMono}" FontSize="12" FontWeight="SemiBold"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding TypeName}" Foreground="{StaticResource EveTextSecondary}" FontFamily="{StaticResource FontUI}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    <Border Grid.Column="2" CornerRadius="4" Padding="6,1" Background="{Binding Color}">
                                                        <TextBlock Text="{Binding RoleTag}" Foreground="#0b0e14" FontFamily="{StaticResource FontUI}" FontSize="10" FontWeight="SemiBold"/>
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8"
                                                Visibility="{Binding Scan.IsLocalResult, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="ALLIANCES" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
                                        <v:HintIcon Text="Who is in the room by alliance, with their share of it. Nothing is marked blue or red, since corp and alliance ids are all FCAT has to judge on."/>
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding Scan.Alliances}"
                                                  Visibility="{Binding Scan.IsLocalResult, Converter={StaticResource BoolToVisibility}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:ScanOrg}">
                                                <Grid Margin="0,0,6,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="44"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Foreground="{StaticResource EveTextPrimary}" FontFamily="{StaticResource FontMono}" FontSize="12" FontWeight="SemiBold">
                                                        <Run Text="{Binding Count, Mode=OneWay}"/><Run Text="×"/>
                                                    </TextBlock>
                                                    <TextBlock Grid.Column="1" Text="{Binding Ticker}" Foreground="{DynamicResource EveAccent}" FontFamily="{StaticResource FontMono}" FontSize="11" FontWeight="SemiBold" Margin="0,0,8,0" VerticalAlignment="Center"
                                                               Visibility="{Binding HasTicker, Converter={StaticResource BoolToVisibility}}"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Name}" Foreground="{StaticResource EveTextSecondary}" FontFamily="{StaticResource FontUI}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding ShareText}" Foreground="{StaticResource EveTextDim}" FontFamily="{StaticResource FontMono}" FontSize="11" VerticalAlignment="Center"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <!-- Secondary board: classes, mass and recons on a d-scan; corps on a local -->
                        <Border Grid.Column="2" BorderBrush="{DynamicResource EveHairline}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <!-- D-scan side -->
                                    <StackPanel Visibility="{Binding Scan.IsShipResult, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="SHIP CLASSES" Style="{StaticResource SectionLabel}" Margin="0,0,0,8"
                                                   Visibility="{Binding Scan.HasShipClasses, Converter={StaticResource BoolToVisibility}}"/>
                                        <ItemsControl ItemsSource="{Binding Scan.ShipClasses}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:ScanClass}">
                                                    <Grid Margin="0,0,0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="32"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Count}" Foreground="{StaticResource EveTextPrimary}" FontFamily="{StaticResource FontMono}" FontSize="12" FontWeight="SemiBold"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{StaticResource EveTextSecondary}" FontFamily="{StaticResource FontUI}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <StackPanel Margin="0,14,0,0" Visibility="{Binding Scan.HasMass, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="MASS" Style="{StaticResource SectionLabel}" Margin="0,0,0,6"/>
                                            <TextBlock Text="{Binding Scan.MassText}" Foreground="{StaticResource EveTextPrimary}" FontFamily="{StaticResource FontMono}" FontSize="14" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Scan.MassNote}" Foreground="{StaticResource EveTextDim}" FontFamily="{StaticResource FontUI}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                        </StackPanel>

                                        <StackPanel Margin="0,16,0,0">
                                            <TextBlock Text="COMBAT RECONS" Style="{StaticResource SectionLabel}" Margin="0,0,0,4"/>
                                            <TextBlock Text="Immune to d-scan. Add what you think is out there." Foreground="{StaticResource EveTextDim}" FontFamily="{StaticResource FontUI}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                            <StackPanel>
                                                <Grid Margin="0,0,0,5">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Background="#0f1622" BorderBrush="{DynamicResource EveHairlineStrong}" BorderThickness="1" CornerRadius="5" Height="24">
                                                        <TextBox Text="{Binding Scan.ReconHuginn, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource EveTextPrimary}" CaretBrush="{DynamicResource EveAccent}" FontFamily="{StaticResource FontMono}" FontSize="11" Padding="6,0" VerticalContentAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="Huginn" Foreground="{StaticResource EveTextSecondary}" FontFamily="{StaticResource FontUI}" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                </Grid>
                                                <Grid Margin="0,0,0,5">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Background="#0f1622" BorderBrush="{DynamicResource EveHairlineStrong}" BorderThickness="1" CornerRadius="5" Height="24">
                                                        <TextBox Text="{Binding Scan.ReconLachesis, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource EveTextPrimary}" CaretBrush="{DynamicResource EveAccent}" FontFamily="{StaticResource FontMono}" FontSize="11" Padding="6,0" VerticalContentAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="Lachesis" Foreground="{StaticResource EveTextSecondary}" FontFamily="{StaticResource FontUI}" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                </Grid>
                                                <Grid Margin="0,0,0,5">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Background="#0f1622" BorderBrush="{DynamicResource EveHairlineStrong}" BorderThickness="1" CornerRadius="5" Height="24">
                                                        <TextBox Text="{Binding Scan.ReconRook, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource EveTextPrimary}" CaretBrush="{DynamicResource EveAccent}" FontFamily="{StaticResource FontMono}" FontSize="11" Padding="6,0" VerticalContentAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="Rook" Foreground="{StaticResource EveTextSecondary}" FontFamily="{StaticResource FontUI}" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                </Grid>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Background="#0f1622" BorderBrush="{DynamicResource EveHairlineStrong}" BorderThickness="1" CornerRadius="5" Height="24">
                                                        <TextBox Text="{Binding Scan.ReconCurse, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource EveTextPrimary}" CaretBrush="{DynamicResource EveAccent}" FontFamily="{StaticResource FontMono}" FontSize="11" Padding="6,0" VerticalContentAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="Curse" Foreground="{StaticResource EveTextSecondary}" FontFamily="{StaticResource FontUI}" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                </Grid>
                                            </StackPanel>
                                            <Button Command="{Binding Scan.ApplyReconsCommand}" Style="{StaticResource GhostButton}" Height="28" HorizontalAlignment="Left" Padding="14,0">
                                                <TextBlock Text="Add to scan" FontFamily="{StaticResource FontUI}" FontSize="11"/>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Local side -->
                                    <StackPanel Visibility="{Binding Scan.IsLocalResult, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <TextBlock Text="CORPORATIONS" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
                                            <v:HintIcon Text="The same pilots by corp. Everyone is in a corp and usually an alliance too, so this board runs higher than the one above it."/>
                                        </StackPanel>
                                        <ItemsControl ItemsSource="{Binding Scan.Corporations}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:ScanOrg}">
                                                    <Grid Margin="0,0,0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="32"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Count}" Foreground="{StaticResource EveTextPrimary}" FontFamily="{StaticResource FontMono}" FontSize="12" FontWeight="SemiBold"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{StaticResource EveTextSecondary}" FontFamily="{StaticResource FontUI}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding ShareText}" Foreground="{StaticResource EveTextDim}" FontFamily="{StaticResource FontMono}" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- HUNT - where to take a jump-capable fleet. Measures light years rather than gates,
                 so the answer routinely sits in another region; see HuntViewModel. -->
            <Border Style="{StaticResource Card}" Visibility="{Binding IsHuntPane, Converter={StaticResource BoolToVisibility}}">
              <Grid Margin="20,16,20,16" DataContext="{Binding Hunt}">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0" ClipToBounds="True">
                    <TextBlock Text="RANGE FROM" Foreground="{StaticResource EveTextDim}" FontFamily="{StaticResource FontUI}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <ItemsControl VerticalAlignment="Center" ItemsSource="{Binding Chain}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:HuntHop}">
                          <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource GhostButton}" Padding="4,1" ToolTip="Drop the hops after this one" Command="{Binding DataContext.PopToCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                              <TextBlock FontFamily="{StaticResource FontUI}" FontSize="15" Text="{Binding Name}">
                                <TextBlock.Style>
                                  <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource EveTextDim}" />
                                    <Style.Triggers>
                                      <DataTrigger Value="True" Binding="{Binding IsLast}">
                                        <Setter Property="Foreground" Value="{StaticResource EveTextPrimary}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </TextBlock.Style>
                              </TextBlock>
                            </Button>
                            <TextBlock Text="›" Foreground="{StaticResource EveTextDim}" FontFamily="{StaticResource FontUI}" FontSize="14" VerticalAlignment="Center" Margin="2,0,2,0" Visibility="{Binding IsLast, Converter={StaticResource BoolToInvisibility}}" />
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Foreground="{StaticResource EveTextDim}" FontFamily="{StaticResource FontUI}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" Text="{Binding OriginRegion}" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBox Name="HuntOriginBox" Style="{StaticResource DarkTextBox}" Width="150" VerticalAlignment="Center" ToolTip="Measure from another system, e.g. a hostile staging system" Text="{Binding OriginQuery, UpdateSourceTrigger=PropertyChanged}">
                      <UIElement.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding UseTypedOriginCommand}" />
                        <KeyBinding Key="Escape" Command="{Binding DismissSuggestionsCommand}" />
                      </UIElement.InputBindings>
                    </TextBox>
                    <Popup Placement="Bottom" VerticalOffset="3" AllowsTransparency="True" StaysOpen="False" IsOpen="{Binding HasSuggestions, Mode=OneWay}" PlacementTarget="{Binding ElementName=HuntOriginBox}">
                      <Border Background="{DynamicResource EvePanelBg}" BorderBrush="{DynamicResource EveHairlineStrong}" BorderThickness="1" CornerRadius="6" Padding="3">
                        <ItemsControl MinWidth="150" ItemsSource="{Binding OriginSuggestions}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Padding="8,4" Command="{Binding DataContext.PickOriginCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                <TextBlock Foreground="{StaticResource EveTextSecondary}" FontFamily="{StaticResource FontUI}" FontSize="11" Text="{Binding Name}" />
                              </Button>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </Border>
                    </Popup>
                    <Button Style="{StaticResource GhostButton}" Padding="9,4" Margin="6,0,0,0" Height="30" ToolTip="Start a new route from this system" Command="{Binding UseTypedOriginCommand}">
                      <TextBlock Text="Set origin" Foreground="{DynamicResource EveAccent}" FontFamily="{StaticResource FontUI}" FontSize="11" />
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Padding="9,4" Margin="6,0,0,0" Height="30" ToolTip="Drop every hop and measure from where you actually are" Command="{Binding ClearRouteCommand}">
                      <TextBlock Text="Clear route" Foreground="{StaticResource EveTextSecondary}" FontFamily="{StaticResource FontUI}" FontSize="11" />
                    </Button>
                    <ComboBox Width="134" Height="30" Margin="14,0,0,0" VerticalAlignment="Center" ToolTip="Range is per hull class, so every dread reaches the same distance" ItemsSource="{Binding Hulls}" SelectedItem="{Binding SelectedHull}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="JDC" Foreground="{StaticResource EveTextDim}" FontFamily="{StaticResource FontUI}" FontSize="11" VerticalAlignment="Center" Margin="8,0,5,0" />
                    <ComboBox Width="54" Height="30" VerticalAlignment="Center" ItemsSource="{Binding CalibrationLevels}" SelectedItem="{Binding CalibrationLevel}" />
                    <Button Style="{StaticResource GhostButton}" Padding="8,4" Margin="6,0,0,0" Height="30" ToolTip="Refresh activity" Command="{Binding RefreshCommand}">
                      <Path Data="{StaticResource IconRefresh}" Style="{StaticResource ButtonIcon}" Stroke="{DynamicResource EveAccent}"/>
                    </Button>
                  </StackPanel>
                </Grid>
                <StackPanel Grid.Row="1" Margin="0,10,0,8">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Foreground="{DynamicResource EveAccent}" FontFamily="{StaticResource FontUI}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" Text="{Binding RangeText}" ToolTip="{Binding RangeSourceText}" />
                    <Border CornerRadius="3" BorderBrush="{DynamicResource EveHairlineStrong}" BorderThickness="1" Padding="6,1" Height="18" Margin="9,4,0,0" VerticalAlignment="Center" ToolTip="{Binding RangeSourceText}">
                      <TextBlock Foreground="{StaticResource EveTextSecondary}" FontFamily="{StaticResource FontUI}" FontSize="11" VerticalAlignment="Center" Text="{Binding CynoText}" />
                    </Border>
                    <TextBlock Foreground="{StaticResource EveTextSecondary}" FontFamily="{StaticResource FontUI}" FontSize="12" VerticalAlignment="Bottom" Margin="10,0,0,4" TextTrimming="CharacterEllipsis" Text="{Binding Status}" />
                    <TextBlock Foreground="{DynamicResource EveAmber}" FontFamily="{StaticResource FontUI}" FontSize="11" VerticalAlignment="Bottom" Margin="10,0,0,4" TextTrimming="CharacterEllipsis" Text="{Binding ChainNote}" Visibility="{Binding ChainNote, Converter={StaticResource StringToVisibility}}" />
                  </StackPanel>
                  <!-- Where the fleet is being sent. This is FCAT's own marker, not an in-game
                       waypoint - the board is the command centre for a blops or cap drop, so it
                       holds the call and drops it once somebody is actually in system. -->
                  <Border CornerRadius="4" Background="#141B2B" BorderBrush="{DynamicResource EveAccent}"
                          BorderThickness="1" Padding="10,5" Margin="0,10,0,0" HorizontalAlignment="Left"
                          Visibility="{Binding HasDestination, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="DESTINATION" Foreground="{StaticResource EveTextDim}"
                                 FontFamily="{StaticResource FontUI}" FontSize="10" FontWeight="Bold"
                                 VerticalAlignment="Center" Margin="0,0,9,0" />
                      <TextBlock Text="{Binding DestinationName}" Foreground="{DynamicResource EveAccent}"
                                 FontFamily="{StaticResource FontMono}" FontSize="13" FontWeight="SemiBold"
                                 VerticalAlignment="Center" />
                      <TextBlock Text="{Binding DestinationNote}" Foreground="{StaticResource EveTextDim}"
                                 FontFamily="{StaticResource FontUI}" FontSize="11"
                                 VerticalAlignment="Center" Margin="10,0,0,0" />
                      <Button Command="{Binding ClearDestinationCommand}" Style="{StaticResource GhostButton}"
                              Padding="8,1" Margin="12,0,0,0" ToolTip="Drop the destination">
                        <TextBlock Text="Clear" Foreground="{StaticResource EveTextSecondary}"
                                   FontFamily="{StaticResource FontUI}" FontSize="11" />
                      </Button>
                    </StackPanel>
                  </Border>

                  <!-- Said once the destination clears itself, so the FC sees who got there. -->
                  <TextBlock Text="{Binding DestinationNote}" Foreground="{StaticResource EveGreen}"
                             FontFamily="{StaticResource FontUI}" FontSize="11" Margin="0,10,0,0">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                          <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                              <Condition Binding="{Binding HasDestination}" Value="False" />
                              <Condition Binding="{Binding DestinationNote, Converter={StaticResource StringToVisibility}}" Value="Visible" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                          </MultiDataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>

                  <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="RANK BY" Foreground="{StaticResource EveTextDim}" FontFamily="{StaticResource FontUI}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Button CommandParameter="Activity" Style="{StaticResource GhostButton}" Padding="11,4" Margin="12,0,0,0" ToolTip="Rank by where the ratting is" Command="{Binding SetRankModeCommand}">
                      <TextBlock Text="Activity" FontFamily="{StaticResource FontUI}" FontSize="11">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource EveTextDim}" />
                            <Style.Triggers>
                              <DataTrigger Value="True" Binding="{Binding IsRankActivity}">
                                <Setter Property="Foreground" Value="{DynamicResource EveAccent}" />
                                <Setter Property="FontWeight" Value="Bold" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </Button>
                    <Button CommandParameter="Coverage" Style="{StaticResource GhostButton}" Padding="11,4" Margin="5,0,0,0" ToolTip="Rank by what staging there opens up - where to seed a cyno" Command="{Binding SetRankModeCommand}">
                      <TextBlock Text="Coverage" FontFamily="{StaticResource FontUI}" FontSize="11">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource EveTextDim}" />
                            <Style.Triggers>
                              <DataTrigger Value="True" Binding="{Binding IsRankCoverage}">
                                <Setter Property="Foreground" Value="{DynamicResource EveAccent}" />
                                <Setter Property="FontWeight" Value="Bold" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </Button>
                    <TextBlock Text="measuring…" Foreground="{DynamicResource EveAmber}" FontFamily="{StaticResource FontUI}" FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="{Binding CoverageBusy, Converter={StaticResource BoolToVisibility}}" />
                  </StackPanel>
                </StackPanel>
                <Grid Grid.Row="2" Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="420" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid Grid.Column="0" IsSharedSizeScope="True">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,4" HorizontalAlignment="Left" Width="{Binding ActualWidth, ElementName=HuntRowsPanel}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="HuntNpc" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="HuntRange" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="HuntLinks" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="26,0,0,0">
                        <TextBlock Text="SYSTEM" Foreground="{StaticResource EveTextDim}" FontFamily="{StaticResource FontUI}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <v:HintIcon Text="Everything listed is one jump, so distance can't rank it. Activity sorts by where the ratting is, coverage by what staging there would open up." />
                      </StackPanel>
                      <Grid Grid.Column="1" Width="124" Margin="8,0,0,0">
                        <TextBlock HorizontalAlignment="Left" Foreground="{StaticResource EveTextDim}" FontFamily="{StaticResource FontUI}" FontSize="11" FontWeight="Bold" MinWidth="44" TextAlignment="Right">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Setter Property="Text" Value="NPC 1H" />
                              <Style.Triggers>
                                <DataTrigger Value="True" Binding="{Binding IsRankCoverage}">
                                  <Setter Property="Text" Value="REACH" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </Grid>
                      <TextBlock Grid.Column="2" Text="RANGE" Foreground="{StaticResource EveTextDim}" FontFamily="{StaticResource FontUI}" FontSize="11" FontWeight="Bold" MinWidth="46" TextAlignment="Right" Margin="8,0,0,0" />
                      <Border Grid.Column="3" Margin="12,0,0,0" />
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                      <ItemsControl Name="HuntRowsPanel" ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="{x:Type vm:HuntRow}">
                            <Border BorderBrush="{DynamicResource EveHairline}" BorderThickness="0,0,0,1" Padding="0,6,0,6" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                              <FrameworkElement.ContextMenu>
                                <ContextMenu>
                                  <MenuItem Header="Use as mid-point" Command="{Binding PlacementTarget.Tag.AddMidpointCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                  <MenuItem Header="Open in Dotlan" Command="{Binding PlacementTarget.Tag.OpenDotlanCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                  <MenuItem Header="Open on zKillboard" Command="{Binding PlacementTarget.Tag.OpenZkillCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                </ContextMenu>
                              </FrameworkElement.ContextMenu>
                              <Border.Style>
                                <Style TargetType="Border">
                                  <Setter Property="Background" Value="Transparent" />
                                  <Style.Triggers>
                                    <Trigger Property="UIElement.IsMouseOver" Value="True">
                                      <Setter Property="Background" Value="{DynamicResource EveRaisedBg}" />
                                    </Trigger>
                                  </Style.Triggers>
                                </Style>
                              </Border.Style>
                              <Grid>
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="Auto" />
                                  <ColumnDefinition Width="*" />
                                  <ColumnDefinition Width="Auto" SharedSizeGroup="HuntNpc" />
                                  <ColumnDefinition Width="Auto" SharedSizeGroup="HuntRange" />
                                  <ColumnDefinition Width="Auto" SharedSizeGroup="HuntLinks" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Foreground="{StaticResource EveTextDim}" FontFamily="{StaticResource FontUI}" FontSize="11" VerticalAlignment="Center" MinWidth="18" TextAlignment="Right" Margin="0,0,8,0" Text="{Binding Rank}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                  <TextBlock Foreground="{StaticResource EveTextPrimary}" FontFamily="{StaticResource FontUI}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" MinWidth="58" Text="{Binding Name}" />
                                  <Border CornerRadius="3" Background="#2a2140" BorderBrush="{DynamicResource EveAccent}" BorderThickness="1" Padding="4,0" Height="14" Margin="7,1,0,0" VerticalAlignment="Center" ToolTip="Out of reach from anywhere earlier in the route" Visibility="{Binding ShowNew, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="NEW" Foreground="{DynamicResource EveAccent}" FontFamily="{StaticResource FontUI}" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" />
                                  </Border>
                                  <Border CornerRadius="3" Background="#1d3326" BorderBrush="{DynamicResource EveGreen}" BorderThickness="1" Padding="4,0" Height="14" Margin="5,1,0,0" VerticalAlignment="Center" ToolTip="NPC kills went up since the last refresh" Visibility="{Binding IsRising, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="RISING" Foreground="{DynamicResource EveGreen}" FontFamily="{StaticResource FontUI}" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" />
                                  </Border>
                                  <Border CornerRadius="3" Background="#3a1f1d" BorderBrush="{DynamicResource EveCritical}" BorderThickness="1" Padding="4,0" Height="14" Margin="5,1,0,0" VerticalAlignment="Center" ToolTip="PvP kills there in the last hour - someone else is already on it" Visibility="{Binding IsContested, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock FontFamily="{StaticResource FontUI}" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource EveCritical}">
                                      <Run Text="{Binding PvpText, Mode=OneWay}" />
                                      <Run Text=" PVP" />
                                    </TextBlock>
                                  </Border>
                                  <TextBlock Foreground="{DynamicResource EveAmber}" FontFamily="{StaticResource FontUI}" FontSize="11" VerticalAlignment="Center" Margin="8,1,0,0" Text="{Binding Region}" Visibility="{Binding ShowRegion, Converter={StaticResource BoolToVisibility}}" />
                                  <TextBlock Foreground="{StaticResource EveTextDim}" FontFamily="{StaticResource FontUI}" FontSize="11" VerticalAlignment="Center" Margin="8,1,0,0" ToolTip="Regions this system can reach in one jump" Text="{Binding OnwardRegionsText}" Visibility="{Binding DataContext.IsRankCoverage, Converter={StaticResource BoolToVisibility}, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                </StackPanel>
                                <Grid Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0" Width="124">
                                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Visibility="{Binding DataContext.IsRankActivity, Converter={StaticResource BoolToVisibility}, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                    <TextBlock Foreground="{DynamicResource EveAmber}" FontFamily="{StaticResource FontUI}" FontSize="12" VerticalAlignment="Center" MinWidth="44" TextAlignment="Right" Text="{Binding NpcText}" />
                                    <TextBlock Foreground="{DynamicResource EveGreen}" FontFamily="{StaticResource FontUI}" FontSize="11" VerticalAlignment="Center" MinWidth="32" TextAlignment="Left" Margin="4,1,0,0" Text="{Binding DeltaText}" />
                                    <Rectangle Height="4" RadiusX="2" RadiusY="2" HorizontalAlignment="Left" VerticalAlignment="Center" Fill="{DynamicResource EveAmber}" Opacity="0.7" Margin="4,0,0,0" Width="{Binding BarWidth}" />
                                  </StackPanel>
                                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Visibility="{Binding DataContext.IsRankCoverage, Converter={StaticResource BoolToVisibility}, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                    <TextBlock Foreground="{DynamicResource EveAccent}" FontFamily="{StaticResource FontUI}" FontSize="12" VerticalAlignment="Center" MinWidth="44" TextAlignment="Right" Text="{Binding OnwardText}" />
                                    <TextBlock Foreground="{DynamicResource EveGreen}" FontFamily="{StaticResource FontUI}" FontSize="11" VerticalAlignment="Center" MinWidth="32" TextAlignment="Left" Margin="4,1,0,0" Text="{Binding OnwardNewText}" />
                                    <Rectangle Height="4" RadiusX="2" RadiusY="2" HorizontalAlignment="Left" VerticalAlignment="Center" Fill="{DynamicResource EveAccent}" Opacity="0.7" Margin="4,0,0,0" Width="{Binding BarWidth}" />
                                  </StackPanel>
                                </Grid>
                                <TextBlock Grid.Column="3" Foreground="{StaticResource EveTextSecondary}" FontFamily="{StaticResource FontUI}" FontSize="12" VerticalAlignment="Center" MinWidth="46" TextAlignment="Right" Margin="8,0,0,0" Text="{Binding RangeText}" />
                                <!-- Hunting: point the fleet at a target. Staging: chain the next jump.
                                     Coverage exists to move the fleet forward, so it keeps the mid-point. -->
                                <Button Grid.Column="4" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource GhostButton}" Padding="8,2"
                                        ToolTip="Point the fleet here. Clears itself once a fleet member or one of your alts is in system"
                                        Visibility="{Binding DataContext.IsRankActivity, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVisibility}}"
                                        Command="{Binding DataContext.SetDestinationCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                  <TextBlock Text="Set destination" Foreground="{DynamicResource EveAccent}" FontFamily="{StaticResource FontUI}" FontSize="11" />
                                </Button>
                                <Button Grid.Column="4" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource GhostButton}" Padding="8,2"
                                        ToolTip="Stage here, then measure the next jump from this system"
                                        Visibility="{Binding DataContext.IsRankCoverage, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVisibility}}"
                                        Command="{Binding DataContext.AddMidpointCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                  <TextBlock Text="Mid-point" Foreground="{DynamicResource EveAccent}" FontFamily="{StaticResource FontUI}" FontSize="11" />
                                </Button>
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                  </Grid>
                  <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="*" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ItemsControl Grid.Row="0" Margin="0,0,0,6" ItemsSource="{Binding RegionsInRange}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:HuntRegion}">
                          <Button Style="{StaticResource GhostButton}" Padding="8,3" Margin="0,0,5,4" Command="{Binding DataContext.SetMapRegionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                            <TextBlock FontFamily="{StaticResource FontUI}" FontSize="11" Text="{Binding Label}">
                              <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                  <Setter Property="Foreground" Value="{StaticResource EveTextDim}" />
                                  <Style.Triggers>
                                    <DataTrigger Value="True" Binding="{Binding IsSelected}">
                                      <Setter Property="Foreground" Value="{DynamicResource EveAccent}" />
                                      <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </TextBlock.Style>
                            </TextBlock>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid Name="HuntMapViewport" Grid.Row="1" Background="Transparent" ClipToBounds="True" SizeChanged="OnHuntMapSizeChanged">
                      <ItemsControl ItemsSource="{Binding MapLinks}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <Canvas />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="{x:Type vm:HuntMapLink}">
                            <Line Stroke="{DynamicResource EveHairlineStrong}" StrokeThickness="1" Opacity="0.55" X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <!-- Labels sit in their own layer BENEATH the dots. Inside the node template
                           they were clipped to the dot's 24px box mid-name; above the dots their
                           backing plates covered neighbouring systems. Underneath, a name is never
                           truncated and can never hide a system - at worst a dot clips its edge. -->
                      <ItemsControl ItemsSource="{Binding MapNodes}" IsHitTestVisible="False">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <Canvas />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                          <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding LabelLeft}" />
                            <Setter Property="Canvas.Top" Value="{Binding LabelTop}" />
                          </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="{x:Type vm:HuntMapNode}">
                            <Grid Width="160" Height="24"
                                  Visibility="{Binding ShowLabel, Converter={StaticResource BoolToVisibility}}">
                              <!-- A backing tint, so a name stays readable over the gate links. -->
                              <Border CornerRadius="3" Background="#A612121D" Padding="3,0"
                                      HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-11">
                                <TextBlock FontFamily="{StaticResource FontUI}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource EveTextPrimary}"
                                           HorizontalAlignment="Center" Text="{Binding Name}" />
                              </Border>
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <ItemsControl ItemsSource="{Binding MapNodes}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <Canvas />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                          <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding Left}" />
                            <Setter Property="Canvas.Top" Value="{Binding Top}" />
                          </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="{x:Type vm:HuntMapNode}">
                            <Grid Width="24" Height="24" Background="Transparent" ToolTip="{Binding Tip}" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                              <FrameworkElement.ContextMenu>
                                <ContextMenu>
                                  <TextBlock Foreground="{StaticResource EveTextPrimary}" FontFamily="{StaticResource FontUI}" FontSize="12" FontWeight="SemiBold" Margin="10,6,10,1" Text="{Binding Name}" />
                                  <TextBlock Foreground="{StaticResource EveTextSecondary}" FontFamily="{StaticResource FontUI}" FontSize="11" Margin="10,0,10,4" Text="{Binding RangeLine}" />
                                  <Separator />
                                  <TextBlock Text="LAST HOUR" Foreground="{StaticResource EveTextDim}" FontFamily="{StaticResource FontUI}" FontSize="11" FontWeight="Bold" Margin="10,4,10,2" />
                                  <TextBlock Foreground="{StaticResource EveTextSecondary}" FontFamily="{StaticResource FontUI}" FontSize="11" Margin="10,0,10,5" Text="{Binding StatsLine}" />
                                  <Separator />
                                  <MenuItem Header="Set as destination" Command="{Binding PlacementTarget.Tag.SetDestinationFromMapCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                  <MenuItem Header="Use as mid-point" Command="{Binding PlacementTarget.Tag.AddMidpointFromMapCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                  <MenuItem Header="Open in Dotlan" Command="{Binding PlacementTarget.Tag.OpenDotlanSystemCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                  <MenuItem Header="Open on zKillboard" Command="{Binding PlacementTarget.Tag.OpenZkillSystemCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                </ContextMenu>
                              </FrameworkElement.ContextMenu>
                              <!-- Where the fleet is being sent. Sits outside the activity ring so the two read apart. -->
                              <Ellipse HorizontalAlignment="Center" VerticalAlignment="Center" Width="26" Height="26"
                                       Stroke="{DynamicResource EveAccent}" StrokeThickness="2" StrokeDashArray="2 1.5"
                                       Fill="Transparent" IsHitTestVisible="False"
                                       Visibility="{Binding IsDestination, Converter={StaticResource BoolToVisibility}}" />

                              <!-- One of the FC's own alts, same gold marker the constellation map uses. -->
                              <Border CornerRadius="3" Background="#33120E02" BorderBrush="{StaticResource EveGoldSoft}"
                                      BorderThickness="1" Height="13" Padding="4,0" ToolTip="{Binding AltTip}"
                                      HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-15,0,0"
                                      Visibility="{Binding HasAlt, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding AltBadge}" Foreground="{StaticResource EveGoldSoft}"
                                           FontFamily="{StaticResource FontUI}" FontSize="10" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                              </Border>

                              <Ellipse HorizontalAlignment="Center" VerticalAlignment="Center" StrokeThickness="1.5" Fill="Transparent" IsHitTestVisible="False" Width="{Binding RingSize}" Height="{Binding RingSize}">
                                <Ellipse.Style>
                                  <Style TargetType="Ellipse">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                      <DataTrigger Value="Rising" Binding="{Binding Ring}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Setter Property="Stroke" Value="{DynamicResource EveGreen}" />
                                      </DataTrigger>
                                      <DataTrigger Value="Contested" Binding="{Binding Ring}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Setter Property="Stroke" Value="{DynamicResource EveCritical}" />
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </Ellipse.Style>
                              </Ellipse>
                              <Ellipse HorizontalAlignment="Center" VerticalAlignment="Center" Width="{Binding Size}" Height="{Binding Size}">
                                <Ellipse.Style>
                                  <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource EveAmber}" />
                                    <Setter Property="UIElement.Opacity" Value="1" />
                                    <Style.Triggers>
                                      <DataTrigger Value="Out" Binding="{Binding Tone}">
                                        <Setter Property="Fill" Value="#4A5468" />
                                        <Setter Property="UIElement.Opacity" Value="0.5" />
                                      </DataTrigger>
                                      <DataTrigger Value="Quiet" Binding="{Binding Tone}">
                                        <Setter Property="UIElement.Opacity" Value="0.3" />
                                      </DataTrigger>
                                      <DataTrigger Value="Light" Binding="{Binding Tone}">
                                        <Setter Property="UIElement.Opacity" Value="0.55" />
                                      </DataTrigger>
                                      <DataTrigger Value="Steady" Binding="{Binding Tone}">
                                        <Setter Property="UIElement.Opacity" Value="0.8" />
                                      </DataTrigger>
                                      <DataTrigger Value="Origin" Binding="{Binding Tone}">
                                        <Setter Property="Fill" Value="{DynamicResource EveAccent}" />
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </Ellipse.Style>
                              </Ellipse>
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Grid>
                    <WrapPanel Grid.Row="2" Margin="0,8,0,0">
                      <StackPanel Orientation="Horizontal" Margin="0,0,14,3">
                        <Ellipse Width="6" Height="6" Fill="#4A5468" Opacity="0.5" VerticalAlignment="Center" />
                        <TextBlock Text="out of range" Foreground="{StaticResource EveTextDim}" FontFamily="{StaticResource FontUI}" FontSize="11" Margin="5,0,0,0" VerticalAlignment="Center" />
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Margin="0,0,14,3">
                        <Ellipse Width="7" Height="7" Fill="{DynamicResource EveAmber}" Opacity="0.3" VerticalAlignment="Center" />
                        <Ellipse Width="10" Height="10" Fill="{DynamicResource EveAmber}" Opacity="0.7" VerticalAlignment="Center" Margin="3,0,0,0" />
                        <Ellipse Width="13" Height="13" Fill="{DynamicResource EveAmber}" VerticalAlignment="Center" Margin="3,0,0,0" />
                        <TextBlock Text="in range, bigger = more ratting" Foreground="{StaticResource EveTextDim}" FontFamily="{StaticResource FontUI}" FontSize="11" Margin="5,0,0,0" VerticalAlignment="Center" />
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Margin="0,0,14,3">
                        <Ellipse Width="11" Height="11" Fill="Transparent" Stroke="{DynamicResource EveGreen}" StrokeThickness="1.5" VerticalAlignment="Center" />
                        <TextBlock Text="ratting rising" Foreground="{StaticResource EveTextDim}" FontFamily="{StaticResource FontUI}" FontSize="11" Margin="5,0,0,0" VerticalAlignment="Center" />
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Margin="0,0,14,3">
                        <Ellipse Width="11" Height="11" Fill="Transparent" Stroke="{DynamicResource EveCritical}" StrokeThickness="1.5" VerticalAlignment="Center" />
                        <TextBlock Text="kills there" Foreground="{StaticResource EveTextDim}" FontFamily="{StaticResource FontUI}" FontSize="11" Margin="5,0,0,0" VerticalAlignment="Center" />
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                        <Ellipse Width="12" Height="12" Fill="{DynamicResource EveAccent}" VerticalAlignment="Center" />
                        <TextBlock Foreground="{StaticResource EveTextDim}" FontFamily="{StaticResource FontUI}" FontSize="11" Margin="5,0,0,0" VerticalAlignment="Center" Text="{Binding OriginRoleLower}" />
                      </StackPanel>
                    </WrapPanel>
                  </Grid>
                </Grid>
              </Grid>
            </Border>

                </Grid>
            </Grid>

            <!-- INTEL FEED (right-hand column - zKill + in-game intel channel) -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid Margin="14,12,14,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="INTEL FEED" Style="{StaticResource SectionLabel}" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Source filter -->
                            <Border CornerRadius="5" Background="#0f1622" BorderBrush="{DynamicResource EveHairlineStrong}" BorderThickness="1" Padding="2" Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource FilterBtn}" Command="{Binding Feed.SetFilterCommand}" CommandParameter="All">
                                        <TextBlock Text="All" FontFamily="{StaticResource FontUI}" FontSize="11" FontWeight="SemiBold">
                                            <TextBlock.Style><Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource EveTextDim}"/>
                                                <Style.Triggers><DataTrigger Binding="{Binding Feed.IsAll}" Value="True"><Setter Property="Foreground" Value="{DynamicResource EveAccent}"/></DataTrigger></Style.Triggers>
                                            </Style></TextBlock.Style>
                                        </TextBlock>
                                    </Button>
                                    <Button Style="{StaticResource FilterBtn}" Command="{Binding Feed.SetFilterCommand}" CommandParameter="Kills">
                                        <TextBlock Text="Kills" FontFamily="{StaticResource FontUI}" FontSize="11" FontWeight="SemiBold">
                                            <TextBlock.Style><Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource EveTextDim}"/>
                                                <Style.Triggers><DataTrigger Binding="{Binding Feed.IsKills}" Value="True"><Setter Property="Foreground" Value="{StaticResource EveCritical}"/></DataTrigger></Style.Triggers>
                                            </Style></TextBlock.Style>
                                        </TextBlock>
                                    </Button>
                                    <Button Style="{StaticResource FilterBtn}" Command="{Binding Feed.SetFilterCommand}" CommandParameter="Reports">
                                        <TextBlock Text="Reports" FontFamily="{StaticResource FontUI}" FontSize="11" FontWeight="SemiBold">
                                            <TextBlock.Style><Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource EveTextDim}"/>
                                                <Style.Triggers><DataTrigger Binding="{Binding Feed.IsReports}" Value="True"><Setter Property="Foreground" Value="{DynamicResource EveAccent}"/></DataTrigger></Style.Triggers>
                                            </Style></TextBlock.Style>
                                        </TextBlock>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Feed.ChannelStatus}" Foreground="{StaticResource EveTextDim}"
                                   FontFamily="{StaticResource FontUI}" FontSize="9" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <!-- Empty state -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="4,0,4,0"
                                Visibility="{Binding Feed.Entries.Count, Converter={StaticResource CountToInvisibility}}">
                        <TextBlock Text="No intel yet" Foreground="{StaticResource EveTextSecondary}"
                                   FontFamily="{StaticResource FontUI}" FontSize="12" HorizontalAlignment="Center"/>
                        <TextBlock Text="Kills in your system and intel-channel reports for your region appear here." Foreground="{StaticResource EveTextDim}"
                                   FontFamily="{StaticResource FontUI}" FontSize="11" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Feed.EntriesView}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:IntelEntry}">
                                    <Border Background="{DynamicResource EveRaisedBg}" CornerRadius="6" Padding="10,6" Margin="0,0,4,5"
                                            BorderThickness="3,0,0,0"
                                            Tag="{Binding DataContext.Feed, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="{DynamicResource EveAccent}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsKill}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{StaticResource EveCritical}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Open on zKillboard"
                                                          Visibility="{Binding HasUrl, Converter={StaticResource BoolToVisibility}}"
                                                          Command="{Binding PlacementTarget.Tag.OpenCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}"/>
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <!-- Narrow column layout: the feed is a tall rail now, so a
                                             row stacks (tag + time + system, then the detail) rather
                                             than spreading across six columns. -->
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Border CornerRadius="3" Padding="5,1" VerticalAlignment="Center" Margin="0,0,7,0">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#2a3343"/>
                                                            <Style.Triggers>
                                                                <!-- one of theirs went down -->
                                                                <DataTrigger Binding="{Binding Side}" Value="Other">
                                                                    <Setter Property="Background" Value="#12301f"/>
                                                                </DataTrigger>
                                                                <!-- one of ours did -->
                                                                <DataTrigger Binding="{Binding Side}" Value="Friendly">
                                                                    <Setter Property="Background" Value="#3a1c1c"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Side}" Value="Unknown">
                                                                    <Setter Property="Background" Value="#33280c"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Tag}" FontFamily="{StaticResource FontUI}" FontSize="9" FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource EveAccent}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Side}" Value="Other">
                                                                        <Setter Property="Foreground" Value="{StaticResource EveGreen}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Side}" Value="Friendly">
                                                                        <Setter Property="Foreground" Value="{StaticResource EveCritical}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Side}" Value="Unknown">
                                                                        <Setter Property="Foreground" Value="{StaticResource EveAmber}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                                <TextBlock Text="{Binding System}" Foreground="{StaticResource EveGoldSoft}"
                                                           FontFamily="{StaticResource FontMono}" FontSize="11" FontWeight="SemiBold"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <Border CornerRadius="3" Padding="4,0" VerticalAlignment="Center" Margin="6,0,0,0"
                                                        Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#2a3343"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Clear"><Setter Property="Background" Value="#15301f"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="NoVisual"><Setter Property="Background" Value="#33280c"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Incoming"><Setter Property="Background" Value="#3a1c1c"/></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding StatusText}" FontFamily="{StaticResource FontUI}" FontSize="9" FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{StaticResource EveTextSecondary}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Clear"><Setter Property="Foreground" Value="{StaticResource EveGreen}"/></DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="NoVisual"><Setter Property="Foreground" Value="{StaticResource EveAmber}"/></DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Incoming"><Setter Property="Foreground" Value="{StaticResource EveCritical}"/></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                                <TextBlock Text="{Binding Time, StringFormat=HH:mm}" Foreground="{StaticResource EveTextDim}"
                                                           FontFamily="{StaticResource FontMono}" FontSize="10" VerticalAlignment="Center"
                                                           HorizontalAlignment="Right" Margin="6,0,0,0"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Detail}" Foreground="{StaticResource EveTextPrimary}"
                                                       FontFamily="{StaticResource FontUI}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                            <TextBlock Text="{Binding Meta}" Foreground="{StaticResource EveTextDim}"
                                                       FontFamily="{StaticResource FontUI}" FontSize="9" Margin="0,2,0,0"
                                                       TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding Meta, Converter={StaticResource StringToVisibility}}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
