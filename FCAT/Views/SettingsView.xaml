<UserControl x:Class="FCAT.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FCAT.ViewModels"
             d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>
        <!-- Dark themed text box -->
        <!-- Settings' inputs are paths and channel prefixes, so they use the monospaced variant. -->
        <Style x:Key="DarkTextBox" TargetType="TextBox" BasedOn="{StaticResource PathTextBox}"/>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page header -->
        <StackPanel Grid.Row="0" Margin="34,24,34,16">
            <TextBlock Text="CONFIGURATION" Style="{StaticResource PageEyebrow}"/>
            <TextBlock Text="Settings" Style="{StaticResource PageTitle}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="34,0,34,24">
            <Grid HorizontalAlignment="Left" MaxWidth="1180">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="22"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN: appearance + log sources -->
            <Border Grid.Column="0" Style="{StaticResource Card}" VerticalAlignment="Top">
            <StackPanel Margin="28,24,28,24">

                <!-- Colour theme -->
                <TextBlock Text="THEME" Style="{StaticResource SectionLabel}" Margin="0,0,0,7"/>
                <TextBlock Text="Recolours the whole app instantly. Your pick is remembered."
                           Foreground="{StaticResource EveTextDim}" FontFamily="{StaticResource FontUI}" FontSize="11"
                           TextWrapping="Wrap" Margin="0,0,0,10"/>
                <WrapPanel>
                    <Grid Width="176" Height="52" Margin="0,0,10,10">
                        <Border CornerRadius="8" Background="{DynamicResource EveRaisedBg}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="{DynamicResource EveHairlineStrong}"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsNebula}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource EveAccent}"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                                <Border Width="24" Height="24" CornerRadius="6" Background="#a98ce0" Margin="0,0,10,0"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Nebula" Foreground="{StaticResource EveTextPrimary}" FontFamily="{StaticResource FontUI}" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Text="Violet · default" Foreground="{StaticResource EveTextDim}" FontFamily="{StaticResource FontUI}" FontSize="10" Margin="0,1,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Button Command="{Binding SelectThemeCommand}" CommandParameter="Nebula" Cursor="Hand" FocusVisualStyle="{x:Null}">
                            <Button.Template><ControlTemplate TargetType="Button"><Border Background="Transparent"/></ControlTemplate></Button.Template>
                        </Button>
                    </Grid>
                    <Grid Width="176" Height="52" Margin="0,0,10,10">
                        <Border CornerRadius="8" Background="{DynamicResource EveRaisedBg}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="{DynamicResource EveHairlineStrong}"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCarbon}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource EveAccent}"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                                <Border Width="24" Height="24" CornerRadius="6" Background="#d99a3f" Margin="0,0,10,0"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Carbon" Foreground="{StaticResource EveTextPrimary}" FontFamily="{StaticResource FontUI}" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Text="Amber · gold" Foreground="{StaticResource EveTextDim}" FontFamily="{StaticResource FontUI}" FontSize="10" Margin="0,1,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Button Command="{Binding SelectThemeCommand}" CommandParameter="Carbon" Cursor="Hand" FocusVisualStyle="{x:Null}">
                            <Button.Template><ControlTemplate TargetType="Button"><Border Background="Transparent"/></ControlTemplate></Button.Template>
                        </Button>
                    </Grid>
                    <Grid Width="176" Height="52" Margin="0,0,10,10">
                        <Border CornerRadius="8" Background="{DynamicResource EveRaisedBg}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="{DynamicResource EveHairlineStrong}"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPhoton}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource EveAccent}"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                                <Border Width="24" Height="24" CornerRadius="6" Background="#4d9be0" Margin="0,0,10,0"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Photon" Foreground="{StaticResource EveTextPrimary}" FontFamily="{StaticResource FontUI}" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Text="Blue · EVE UI" Foreground="{StaticResource EveTextDim}" FontFamily="{StaticResource FontUI}" FontSize="10" Margin="0,1,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Button Command="{Binding SelectThemeCommand}" CommandParameter="Photon" Cursor="Hand" FocusVisualStyle="{x:Null}">
                            <Button.Template><ControlTemplate TargetType="Button"><Border Background="Transparent"/></ControlTemplate></Button.Template>
                        </Button>
                    </Grid>
                    <Grid Width="176" Height="52" Margin="0,0,10,10">
                        <Border CornerRadius="8" Background="{DynamicResource EveRaisedBg}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="{DynamicResource EveHairlineStrong}"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRust}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource EveAccent}"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                                <Border Width="24" Height="24" CornerRadius="6" Background="#c06544" Margin="0,0,10,0"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Rust" Foreground="{StaticResource EveTextPrimary}" FontFamily="{StaticResource FontUI}" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Text="Rust red" Foreground="{StaticResource EveTextDim}" FontFamily="{StaticResource FontUI}" FontSize="10" Margin="0,1,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Button Command="{Binding SelectThemeCommand}" CommandParameter="Rust" Cursor="Hand" FocusVisualStyle="{x:Null}">
                            <Button.Template><ControlTemplate TargetType="Button"><Border Background="Transparent"/></ControlTemplate></Button.Template>
                        </Button>
                    </Grid>
                </WrapPanel>

                <Rectangle Height="1" Fill="{DynamicResource EveHairline}" Margin="0,18,0,18"/>

                <!-- EVE logs folder -->
                <TextBlock Text="EVE LOGS FOLDER" Style="{StaticResource SectionLabel}" Margin="0,0,0,7"/>
                <TextBlock Text="The folder containing your Gamelogs and Chatlogs (combat log + boost channels)."
                           Foreground="{StaticResource EveTextDim}" FontFamily="{StaticResource FontUI}" FontSize="11"
                           TextWrapping="Wrap" Margin="0,0,0,9"/>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Style="{StaticResource DarkTextBox}"
                             Text="{Binding EveLogsPath, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Grid.Column="1" Command="{Binding BrowseCommand}" Style="{StaticResource SecondaryButton}"
                            Padding="14,0" Margin="8,0,0,0">
                        <TextBlock Text="Browse…" FontFamily="{StaticResource FontUI}" FontSize="12"/>
                    </Button>
                    <Button Grid.Column="2" Command="{Binding ResetToDefaultCommand}" Style="{StaticResource GhostButton}"
                            Padding="10,0" Margin="4,0,0,0">
                        <TextBlock Text="Reset" FontFamily="{StaticResource FontUI}" FontSize="12"/>
                    </Button>
                </Grid>

                <!-- Derived path checks -->
                <Border Background="{DynamicResource EveRaisedBg}" CornerRadius="8" Padding="14,12" Margin="0,0,0,20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Gamelogs -->
                        <Ellipse Grid.Row="0" Grid.Column="0" Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,7,8">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource EveCritical}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding GamelogsFound}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource EveGreen}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Gamelogs" Foreground="{StaticResource EveTextSecondary}"
                                   FontFamily="{StaticResource FontUI}" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,8" Width="64"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding GamelogsPath}" Foreground="{StaticResource EveTextDim}"
                                   FontFamily="{StaticResource FontMono}" FontSize="10" VerticalAlignment="Center" Margin="0,0,0,8"
                                   TextTrimming="CharacterEllipsis"/>

                        <!-- Chatlogs -->
                        <Ellipse Grid.Row="1" Grid.Column="0" Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,7,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource EveCritical}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ChatlogsFound}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource EveGreen}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="Chatlogs" Foreground="{StaticResource EveTextSecondary}"
                                   FontFamily="{StaticResource FontUI}" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0" Width="64"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding ChatlogsPath}" Foreground="{StaticResource EveTextDim}"
                                   FontFamily="{StaticResource FontMono}" FontSize="10" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </Border>

                <!-- Boost channel prefix -->
                <TextBlock Text="BOOST CHANNEL NAME" Style="{StaticResource SectionLabel}" Margin="0,0,0,7"/>
                <TextBlock Text="Filename prefix of the boost channel logs to read (default &quot;Boost&quot;)."
                           Foreground="{StaticResource EveTextDim}" FontFamily="{StaticResource FontUI}" FontSize="11"
                           TextWrapping="Wrap" Margin="0,0,0,9"/>
                <TextBox Style="{StaticResource DarkTextBox}" Width="220" HorizontalAlignment="Left"
                         Text="{Binding BoostChannelPrefix, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Intel channel prefix -->
                <TextBlock Text="INTEL CHANNEL NAME" Style="{StaticResource SectionLabel}" Margin="0,18,0,7"/>
                <TextBlock Text="Filename prefix of the in-game intel channel logs to read for the intel feed (default &quot;Intel&quot;). You must be joined to the channel in EVE."
                           Foreground="{StaticResource EveTextDim}" FontFamily="{StaticResource FontUI}" FontSize="11"
                           TextWrapping="Wrap" Margin="0,0,0,9"/>
                <TextBox Style="{StaticResource DarkTextBox}" Width="220" HorizontalAlignment="Left"
                         Text="{Binding IntelChannelPrefix, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Fleet form-up system (autocomplete) -->
                <TextBlock Text="FLEET FORM-UP SYSTEM" Style="{StaticResource SectionLabel}" Margin="0,24,0,7"/>
                <TextBlock Text="The system your fleet stages in. Used by the straggler check to flag pilots who aren't in it yet."
                           Foreground="{StaticResource EveTextDim}" FontFamily="{StaticResource FontUI}" FontSize="11"
                           TextWrapping="Wrap" Margin="0,0,0,9"/>
                <Grid Width="300" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- The box + its suggestion dropdown share column 0 -->
                    <StackPanel Grid.Column="0">
                        <TextBox x:Name="FormupBox" Style="{StaticResource DarkTextBox}"
                                 Text="{Binding FormupSystemText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Type a system name and pick from the list"/>
                        <!-- Suggestions dropdown -->
                        <Border Background="#0f1622" BorderBrush="{DynamicResource EveHairlineStrong}" BorderThickness="1"
                                CornerRadius="7" Margin="0,4,0,0" Padding="4"
                                Visibility="{Binding SystemSuggestions.Count, Converter={StaticResource CountToVisibility}}">
                            <ItemsControl ItemsSource="{Binding SystemSuggestions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.PickSystemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left"
                                                Height="28" Padding="8,0">
                                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource EveTextSecondary}"
                                                       FontFamily="{StaticResource FontUI}" FontSize="12"/>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>
                    <Button Grid.Column="1" Command="{Binding ClearFormupCommand}" Style="{StaticResource GhostButton}"
                            Padding="10,0" Margin="6,0,0,0" VerticalAlignment="Top" Height="34" ToolTip="Clear">
                        <TextBlock Text="✕" FontSize="12" Foreground="{StaticResource EveCritical}"/>
                    </Button>
                </Grid>
                <TextBlock Text="Building system list…" Foreground="{StaticResource EveTextDim}"
                           FontFamily="{StaticResource FontUI}" FontSize="10" Margin="0,5,0,0"
                           Visibility="{Binding SystemsLoading, Converter={StaticResource BoolToVisibility}}"/>

            </StackPanel>
            </Border>

            <!-- RIGHT COLUMN: ESI access, alerts, sounds, demo, updates -->
            <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
            <StackPanel Margin="28,24,28,24">

                <!-- ESI access health -->
                <TextBlock Text="ESI ACCESS" Style="{StaticResource SectionLabel}" Margin="0,0,0,7"/>
                <TextBlock Text="Permissions the active character granted at login. A red dot means FCAT asked for it but the character hasn't authorized it."
                           Foreground="{StaticResource EveTextDim}" FontFamily="{StaticResource FontUI}" FontSize="11"
                           TextWrapping="Wrap" Margin="0,0,0,9"/>
                <ItemsControl ItemsSource="{Binding ScopeHealth}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ScopeStatus}">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource EveCritical}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Granted}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource EveGreen}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding Label}" Foreground="{StaticResource EveTextSecondary}"
                                           FontFamily="{StaticResource FontUI}" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Some access is missing. Remove and re-add this character on the Account page to grant it."
                           Foreground="{StaticResource EveAmber}" FontFamily="{StaticResource FontUI}" FontSize="11"
                           TextWrapping="Wrap" Margin="0,6,0,0"
                           Visibility="{Binding MissingScopes, Converter={StaticResource BoolToVisibility}}"/>
                <TextBlock Text="Log in to check ESI access." Foreground="{StaticResource EveTextDim}"
                           FontFamily="{StaticResource FontUI}" FontSize="11" Margin="0,6,0,0"
                           Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToInvisibility}}"/>

                <!-- Actions -->
                <!-- Demo / sandbox -->
                <Rectangle Height="1" Fill="{DynamicResource EveHairline}" Margin="0,24,0,18"/>
                <TextBlock Text="DEMO / SANDBOX" Style="{StaticResource SectionLabel}" Margin="0,0,0,7"/>
                <TextBlock Text="Runs FCAT on a simulated fleet so you can try Fleet Ops, the dashboard and alerts without being in a live fleet. Intel still uses your real current system. Turn off to go back to live data."
                           Foreground="{StaticResource EveTextDim}" FontFamily="{StaticResource FontUI}" FontSize="11"
                           TextWrapping="Wrap" Margin="0,0,0,9"/>
                <Button Command="{Binding Shell.ToggleDemoCommand}" Style="{StaticResource SecondaryButton}"
                        Height="34" Padding="16,0" HorizontalAlignment="Left"
                        ToolTip="Simulate a fleet for testing / screenshots">
                    <TextBlock FontFamily="{StaticResource FontUI}" FontSize="12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="🧪 Demo mode: OFF"/>
                                <Setter Property="Foreground" Value="{StaticResource EveTextDim}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Shell.DemoMode}" Value="True">
                                        <Setter Property="Text" Value="🧪 Demo mode: ON"/>
                                        <Setter Property="Foreground" Value="{DynamicResource EveAccent}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>

                <!-- Saved data -->
                <Rectangle Height="1" Fill="{DynamicResource EveHairline}" Margin="0,24,0,18"/>
                <TextBlock Text="SAVED DATA" Style="{StaticResource SectionLabel}" Margin="0,0,0,7"/>
                <TextBlock Text="FCAT remembers your Custom ping fields between sessions. Clear them here. This does not touch your saved characters, theme, or other settings."
                           Foreground="{StaticResource EveTextDim}" FontFamily="{StaticResource FontUI}" FontSize="11"
                           TextWrapping="Wrap" Margin="0,0,0,9"/>
                <Button Command="{Binding ClearRememberedPingCommand}" Style="{StaticResource SecondaryButton}"
                        Height="34" Padding="16,0" HorizontalAlignment="Left">
                    <TextBlock Text="Clear saved ping" FontFamily="{StaticResource FontUI}" FontSize="12"/>
                </Button>

                <!-- Updates -->
                <Rectangle Height="1" Fill="{DynamicResource EveHairline}" Margin="0,24,0,18"/>
                <TextBlock Text="UPDATES" Style="{StaticResource SectionLabel}" Margin="0,0,0,7"/>
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="FCAT checks GitHub for new versions on launch."
                                   Foreground="{StaticResource EveTextDim}" FontFamily="{StaticResource FontUI}" FontSize="11"/>
                        <TextBlock Text="{Binding Shell.UpdateStatus}" Foreground="{DynamicResource EveAccent}"
                                   FontFamily="{StaticResource FontUI}" FontSize="11" Margin="0,4,0,0"
                                   Visibility="{Binding Shell.UpdateStatus, Converter={StaticResource StringToVisibility}}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Command="{Binding Shell.CheckForUpdatesCommand}" Style="{StaticResource SecondaryButton}"
                                Height="34" Padding="14,0" Margin="0,0,8,0">
                            <TextBlock Text="Check for updates" FontFamily="{StaticResource FontUI}" FontSize="12"/>
                        </Button>
                        <Button Command="{Binding Shell.ApplyUpdateCommand}" Style="{StaticResource PrimaryButton}"
                                Height="34" Padding="16,0"
                                Visibility="{Binding Shell.UpdateReady, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Restart &amp; update" FontFamily="{StaticResource FontUI}" FontSize="12" FontWeight="SemiBold"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,24,0,0">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource EveGreen}"
                               FontFamily="{StaticResource FontUI}" FontSize="11" VerticalAlignment="Center"/>
                    <Button Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}"
                            Height="40" Width="150" HorizontalAlignment="Right">
                        <TextBlock Text="Save settings" FontFamily="{StaticResource FontUI}" FontSize="13" FontWeight="SemiBold"/>
                    </Button>
                </Grid>
            </StackPanel>
            </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
