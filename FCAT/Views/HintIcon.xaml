<UserControl x:Class="FCAT.Views.HintIcon"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">

    <!-- A "?" chip that explains a page or a panel on hover. The show duration is deliberately long:
         these hints say where a number comes from and what it can't tell you, which is more than a
         tooltip's default few seconds is enough to read. -->
    <Border x:Name="Hit" Background="Transparent" Padding="5,3"
            VerticalAlignment="Center" Cursor="Hand"
            ToolTipService.InitialShowDelay="120"
            ToolTipService.BetweenShowDelay="0"
            ToolTipService.ShowDuration="120000"
            ToolTipService.Placement="Bottom"
            ToolTipService.HorizontalOffset="-8"
            ToolTip="{Binding Text, ElementName=Root}">

        <Border x:Name="Chip" Width="18" Height="18" CornerRadius="9" BorderThickness="1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background"  Value="{DynamicResource EveRaisedBg}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource EveHairlineStrong}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsMouseOver, ElementName=Hit}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource EveAccent}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <TextBlock Text="?" FontFamily="{StaticResource FontUI}" FontSize="11" FontWeight="SemiBold"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource EveTextSecondary}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMouseOver, ElementName=Hit}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource EveAccent}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>
    </Border>
</UserControl>
