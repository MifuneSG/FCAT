<UserControl x:Class="FCAT.Views.ScanExportCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FCAT.ViewModels">
    <!-- Never shown in the app. VisualExporter lays this out off-screen and renders it to a PNG,
         so it has no scroll viewers and its lists are pre-capped by the view model. -->
    <UserControl.Resources>
        <DataTemplate x:Key="CorpRow" DataType="{x:Type vm:ScanOrg}">
            <Grid Margin="0,0,14,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Count}" Foreground="{StaticResource EveTextPrimary}" FontFamily="{StaticResource FontMono}" FontSize="12" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{StaticResource EveTextSecondary}" FontFamily="{StaticResource FontUI}" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="2" Text="NEUT" Foreground="{StaticResource EveTextDim}" FontFamily="{StaticResource FontUI}" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,0,0"
                           Visibility="{Binding IsNeutral, Converter={StaticResource BoolToVisibility}}"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Border Background="{DynamicResource EvePanelBg}" Padding="22,18,22,16">
        <StackPanel>

            <!-- Header -->
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding ScanTitle}" Foreground="{DynamicResource EveAccent}"
                           FontFamily="{StaticResource FontUI}" FontSize="15" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding ScanStamp}" Foreground="{StaticResource EveTextDim}"
                           FontFamily="{StaticResource FontMono}" FontSize="11"
                           VerticalAlignment="Center" Margin="12,0,0,0"/>
            </StackPanel>
            <TextBlock Text="{Binding Summary}" Foreground="{StaticResource EveTextSecondary}"
                       FontFamily="{StaticResource FontUI}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"/>

            <!-- Tallies -->
            <ItemsControl ItemsSource="{Binding RoleBreakdown}" Margin="0,12,0,0">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:FleetStat}">
                        <StackPanel Orientation="Horizontal" Margin="0,0,18,6" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Count}" Foreground="{Binding Color}" FontFamily="{StaticResource FontUI}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Label}" Foreground="{StaticResource EveTextDim}" FontFamily="{StaticResource FontUI}" FontSize="10" Margin="5,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Rectangle Height="1" Fill="{DynamicResource EveHairline}" Margin="0,6,0,12"/>

            <!-- D-SCAN: hulls beside classes and mass -->
            <Grid Visibility="{Binding IsShipResult, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="230"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="SHIPS" Style="{StaticResource SectionLabel}" Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding ExportShips}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:DScanShip}">
                                <Grid Margin="0,0,6,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding CountText}" Foreground="{StaticResource EveTextPrimary}" FontFamily="{StaticResource FontMono}" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" Text="{Binding TypeName}" Foreground="{StaticResource EveTextSecondary}" FontFamily="{StaticResource FontUI}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <Border Grid.Column="2" CornerRadius="4" Padding="6,1" Background="{Binding Color}">
                                        <TextBlock Text="{Binding RoleTag}" Foreground="#0b0e14" FontFamily="{StaticResource FontUI}" FontSize="9" FontWeight="SemiBold"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding ShipOverflow}" Foreground="{StaticResource EveTextDim}" FontFamily="{StaticResource FontUI}" FontSize="11" Margin="0,4,0,0"
                               Visibility="{Binding ShipOverflow, Converter={StaticResource StringToVisibility}}"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="SHIP CLASSES" Style="{StaticResource SectionLabel}" Margin="0,0,0,8"
                               Visibility="{Binding HasShipClasses, Converter={StaticResource BoolToVisibility}}"/>
                    <ItemsControl ItemsSource="{Binding ShipClasses}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ScanClass}">
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Count}" Foreground="{StaticResource EveTextPrimary}" FontFamily="{StaticResource FontMono}" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{StaticResource EveTextSecondary}" FontFamily="{StaticResource FontUI}" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Margin="0,12,0,0" Visibility="{Binding HasMass, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="MASS" Style="{StaticResource SectionLabel}" Margin="0,0,0,5"/>
                        <TextBlock Text="{Binding MassText}" Foreground="{StaticResource EveTextPrimary}" FontFamily="{StaticResource FontMono}" FontSize="13" FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- LOCAL: alliances full width, corps in two columns underneath -->
            <StackPanel Visibility="{Binding IsLocalResult, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="ALLIANCES" Style="{StaticResource SectionLabel}" Margin="0,0,0,8"/>
                <ItemsControl ItemsSource="{Binding Alliances}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ScanOrg}">
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44"/>
                                    <ColumnDefinition Width="64"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Foreground="{StaticResource EveTextPrimary}" FontFamily="{StaticResource FontMono}" FontSize="12" FontWeight="SemiBold">
                                    <Run Text="{Binding Count, Mode=OneWay}"/><Run Text="×"/>
                                </TextBlock>
                                <TextBlock Grid.Column="1" Text="{Binding Ticker}" Foreground="{DynamicResource EveAccent}" FontFamily="{StaticResource FontMono}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding Name}" Foreground="{StaticResource EveTextSecondary}" FontFamily="{StaticResource FontUI}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="3" Text="{Binding Tag}" Foreground="{StaticResource EveTextDim}" FontFamily="{StaticResource FontUI}" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="CORPORATIONS" Style="{StaticResource SectionLabel}" Margin="0,16,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ItemsControl Grid.Column="0" ItemsSource="{Binding ExportCorpsLeft}"  ItemTemplate="{StaticResource CorpRow}"/>
                    <ItemsControl Grid.Column="2" ItemsSource="{Binding ExportCorpsRight}" ItemTemplate="{StaticResource CorpRow}"/>
                </Grid>
                <TextBlock Text="{Binding CorpOverflow}" Foreground="{StaticResource EveTextDim}" FontFamily="{StaticResource FontUI}" FontSize="11" Margin="0,6,0,0"
                           Visibility="{Binding CorpOverflow, Converter={StaticResource StringToVisibility}}"/>
            </StackPanel>

            <Rectangle Height="1" Fill="{DynamicResource EveHairline}" Margin="0,14,0,8"/>
            <Grid>
                <TextBlock Text="FCAT" Foreground="{StaticResource EveTextDim}" FontFamily="{StaticResource FontUI}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Left"/>
                <TextBlock Text="{Binding ManualNote}" Foreground="{StaticResource EveTextDim}" FontFamily="{StaticResource FontUI}" FontSize="10" HorizontalAlignment="Right"
                           Visibility="{Binding ManualNote, Converter={StaticResource StringToVisibility}}"/>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
