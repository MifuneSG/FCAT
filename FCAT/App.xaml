<Application x:Class="FCAT.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:FCAT"
             xmlns:vm="clr-namespace:FCAT.ViewModels"
             xmlns:views="clr-namespace:FCAT.Views"
             Startup="OnStartup">
    <Application.Resources>

        <!-- FCAT PALETTE - "Nebula" (flat, opaque surfaces, violet accent). Lifted off pure black, high-contrast text, no gloss. Gold stays reserved for the FC; semantic red/amber/green unchanged. -->
        <SolidColorBrush x:Key="EveWindowBg"       Color="#101019"/>
        <SolidColorBrush x:Key="EvePanelBg"        Color="#191926"/>
        <SolidColorBrush x:Key="EveRaisedBg"       Color="#23233a"/>
        <SolidColorBrush x:Key="EveRowAltBg"       Color="#4d1e1e30"/>

        <SolidColorBrush x:Key="EveHairline"       Color="#2b2b40"/>
        <SolidColorBrush x:Key="EveHairlineSoft"   Color="#1c1c2b"/>
        <SolidColorBrush x:Key="EveHairlineStrong" Color="#3a3a54"/>

        <SolidColorBrush x:Key="EveAccent"         Color="#a98ce0"/>   <!-- violet - live/interactive -->
        <SolidColorBrush x:Key="EveAccentDim"      Color="#5b5080"/>
        <SolidColorBrush x:Key="EveAccentBright"   Color="#bda2ea"/>   <!-- primary-button hover -->
        <SolidColorBrush x:Key="EveAccentFaint"    Color="#22a98ce0"/> <!-- accent tint - outlined-button fill -->

        <SolidColorBrush x:Key="EveGold"           Color="#d4a449"/>   <!-- FC / wing only -->
        <SolidColorBrush x:Key="EveGoldSoft"       Color="#f0d99a"/>
        <SolidColorBrush x:Key="EveGoldDim"        Color="#7a6530"/>

        <SolidColorBrush x:Key="EveCritical"       Color="#e2574c"/>   <!-- alerts -->
        <SolidColorBrush x:Key="EveAmber"          Color="#c9883e"/>
        <SolidColorBrush x:Key="EveGreen"          Color="#3fae8f"/>

        <!-- Three legible tiers. Data (ship, system, values) uses Secondary or Primary - NEVER Dim. Dim is only for decorative labels/hints, and even it is kept readable. -->
        <SolidColorBrush x:Key="EveTextPrimary"    Color="#e8e9f4"/>
        <SolidColorBrush x:Key="EveTextSecondary"  Color="#bcc0d4"/>   <!-- data / values -->
        <SolidColorBrush x:Key="EveTextDim"        Color="#8a8fac"/>   <!-- labels / hints -->

        <!-- Back-compat aliases (older bindings still reference these names) -->
        <SolidColorBrush x:Key="EveBorderBrush"    Color="#2b2b40"/>
        <SolidColorBrush x:Key="EveGoldBrush"      Color="#d4a449"/>
        <SolidColorBrush x:Key="EveGoldDimBrush"   Color="#7a6530"/>
        <SolidColorBrush x:Key="EveBlueBrush"      Color="#8f86d6"/>
        <SolidColorBrush x:Key="EveBlueDimBrush"   Color="#4a4570"/>
        <SolidColorBrush x:Key="EveRedBrush"       Color="#e2574c"/>
        <SolidColorBrush x:Key="EveGreenBrush"     Color="#3fae8f"/>
        <SolidColorBrush x:Key="EveAmberBrush"     Color="#c9883e"/>
        <SolidColorBrush x:Key="EveTextDimBrush"   Color="#8a8fac"/>

        <!-- Window-chrome surfaces + backdrop stops (MainWindow), retinted per theme by ThemeService. -->
        <SolidColorBrush x:Key="EveTopBarBrush"  Color="#cc12121d"/>
        <SolidColorBrush x:Key="EveNavRailBrush" Color="#990a0d13"/>
        <Color x:Key="EveGlowTopColor">#2b1f52</Color>
        <Color x:Key="EveGlowMidColor">#1a1236</Color>
        <Color x:Key="EveBackdropTopColor">#101019</Color>
        <Color x:Key="EveBackdropMidColor">#0d0d16</Color>
        <Color x:Key="EveBackdropBotColor">#0b0b12</Color>

        <!-- TYPOGRAPHY TOKENS -->
        <FontFamily x:Key="FontUI">Segoe UI</FontFamily>
        <FontFamily x:Key="FontMono">Cascadia Mono, Consolas</FontFamily>

        <!-- VALUE CONVERTERS -->
        <local:BoolToVisibilityConverter   x:Key="BoolToVisibility"/>
        <local:BoolToInvisibilityConverter x:Key="BoolToInvisibility"/>
        <local:InvertBoolConverter         x:Key="InvertBool"/>
        <local:CountToVisibilityConverter  x:Key="CountToVisibility"/>
        <local:CountToInvisibilityConverter x:Key="CountToInvisibility"/>
        <local:StringToVisibilityConverter x:Key="StringToVisibility"/>
        <local:UrlToImageConverter         x:Key="UrlToImage"/>
        <local:NavActiveMultiConverter     x:Key="NavActiveMulti"/>

        <!-- CARD - flat surface, hairline border, soft rounded corners -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background"      Value="{DynamicResource EvePanelBg}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource EveHairline}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="10"/>
        </Style>

        <!-- BUTTONS - rounded, flat, restrained -->
        <!-- Primary - solid accent fill, dark text. One per view. -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background"       Value="{DynamicResource EveAccent}"/>
            <Setter Property="Foreground"       Value="#17122a"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="FontFamily"       Value="{StaticResource FontUI}"/>
            <Setter Property="FontSize"         Value="13"/>
            <Setter Property="FontWeight"       Value="SemiBold"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource EveAccentBright}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary - subtle filled surface with a hairline, not an empty ghost. -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background"       Value="#14ffffff"/>
            <Setter Property="Foreground"       Value="{StaticResource EveTextSecondary}"/>
            <Setter Property="BorderBrush"      Value="{DynamicResource EveHairlineStrong}"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="FontFamily"       Value="{StaticResource FontUI}"/>
            <Setter Property="FontSize"         Value="12"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource EveRaisedBg}"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource EveAccentDim}"/>
                                <Setter Property="Foreground" Value="{StaticResource EveTextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background"       Value="Transparent"/>
            <Setter Property="Foreground"       Value="{StaticResource EveTextDim}"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="FontFamily"       Value="{StaticResource FontUI}"/>
            <Setter Property="FontSize"         Value="12"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource EveRaisedBg}"/>
                                <Setter Property="Foreground" Value="{StaticResource EveTextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- NAV RAIL BUTTON - icon over tiny label, left accent bar + fill when active. Active state read via MultiBinding(ActiveNav, Tag). -->
        <Style x:Key="NavRailButton" TargetType="Button">
            <Setter Property="Background"       Value="Transparent"/>
            <Setter Property="Foreground"       Value="{StaticResource EveTextDim}"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="Height"           Value="58"/>
            <Setter Property="FontFamily"       Value="{StaticResource FontUI}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <!-- active left accent bar -->
                            <Rectangle x:Name="bar" Width="3" HorizontalAlignment="Left"
                                       Margin="0,12" RadiusX="2" RadiusY="2"
                                       Fill="{DynamicResource EveAccent}" Opacity="0"/>
                            <Border x:Name="bg" Background="Transparent" CornerRadius="9" Margin="7,4"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource EveRaisedBg}"/>
                                <Setter Property="Foreground" Value="{StaticResource EveTextSecondary}"/>
                            </Trigger>
                            <DataTrigger Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding Converter="{StaticResource NavActiveMulti}">
                                        <Binding Path="DataContext.ActiveNav" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                        <Binding Path="Tag" RelativeSource="{RelativeSource Self}"/>
                                    </MultiBinding>
                                </DataTrigger.Binding>
                                <Setter TargetName="bar" Property="Opacity" Value="1"/>
                                <Setter TargetName="bg" Property="Background" Value="#211d34"/>
                                <Setter Property="Foreground" Value="{DynamicResource EveAccent}"/>
                            </DataTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- FEATURE CARD BUTTON - large clickable card with hover lift -->
        <Style x:Key="FeatureCardButton" TargetType="Button">
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment"   Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{DynamicResource EvePanelBg}"
                                BorderBrush="{DynamicResource EveHairline}" BorderThickness="1"
                                CornerRadius="10" Padding="18,16">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background"  Value="{DynamicResource EveRaisedBg}"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource EveAccentDim}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- WINDOW CONTROL BUTTON - frameless min/max/close dots -->
        <Style x:Key="WindowControlButton" TargetType="Button">
            <Setter Property="Background"       Value="Transparent"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="Width"            Value="32"/>
            <Setter Property="Height"           Value="28"/>
            <Setter Property="Foreground"       Value="{StaticResource EveTextSecondary}"/>
            <Setter Property="FontFamily"       Value="{StaticResource FontUI}"/>
            <Setter Property="FontSize"         Value="13"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource EveRaisedBg}"/>
                                <Setter Property="Foreground" Value="{StaticResource EveTextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DARK TEXT BOX - the app's single-line/multiline text input.
             The content host sits inside Padding, so a single-line box must size itself; pinning
             Height clips the text. Give the control NEXT to it the fixed height instead. -->
        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background"      Value="#0f1622"/>
            <Setter Property="Foreground"      Value="{StaticResource EveTextPrimary}"/>
            <Setter Property="CaretBrush"      Value="{DynamicResource EveAccent}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource EveHairlineStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily"      Value="{StaticResource FontUI}"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Padding"         Value="9,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                            <Grid>
                                <!-- Hint text, drawn behind the content host and hidden the moment the
                                     box has anything in it. Set local:Placeholder.Text to use it. -->
                                <TextBlock x:Name="Hint" Text="{Binding (local:Placeholder.Text), RelativeSource={RelativeSource TemplatedParent}}"
                                           Foreground="{StaticResource EveTextDim}" FontFamily="{TemplateBinding FontFamily}"
                                           FontSize="{TemplateBinding FontSize}" Margin="{TemplateBinding Padding}"
                                           VerticalAlignment="Center" IsHitTestVisible="False"
                                           TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource EveAccent}"/>
                            </Trigger>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Hint" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Settings holds file paths and channel prefixes, which read better monospaced. -->
        <Style x:Key="PathTextBox" TargetType="TextBox" BasedOn="{StaticResource DarkTextBox}">
            <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
            <Setter Property="Padding"    Value="10,8"/>
        </Style>

        <!-- TYPE SCALE
             Sizes stay on whole pixels. The window renders with TextFormattingMode="Display", which
             snaps glyph metrics to the pixel grid, so a fractional size hints cleanly at neither
             neighbour and comes out blurred - which is what 9.5 in the nav rail was doing.

             Tracking is used sparingly - only where a label stands alone with nothing beside it to
             give it scale, which in practice means the nav rail and the wordmark. Panel headings sit
             directly above the thing they name and read better tight, so they get none. -->

        <!-- SMALL UPPERCASE SECTION LABEL - the app's standard "what is this panel" label. -->
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource EveTextDim}"/>
            <Setter Property="FontFamily" Value="{StaticResource FontUI}"/>
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- NAV RAIL LABEL - under each rail icon. Tracked harder than a section label: it sits in a
             narrow column with no neighbouring text to give it scale. -->
        <Style x:Key="NavRailLabel" TargetType="TextBlock">
            <Setter Property="Foreground"          Value="{StaticResource EveTextSecondary}"/>
            <Setter Property="FontFamily"          Value="{StaticResource FontUI}"/>
            <Setter Property="FontSize"            Value="10"/>
            <Setter Property="FontWeight"          Value="SemiBold"/>
            <Setter Property="local:TextStyle.Tracking" Value="0.14"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin"              Value="0,5,0,0"/>
        </Style>

        <!-- NAV RAIL ICON - one size for all of them, so the rail reads as a column rather than as
             glyphs of assorted weights. -->
        <!-- ICON SET - drawn, not typed. Every icon is a stroked outline on the same 24x24 grid
             with the same 1.5 weight and round caps, so they read as one family at rail size.
             Font glyphs can't do that: ⧉ ◎ ◇ came from different Unicode blocks, so they landed
             at different weights and optical sizes, and the emoji ones fell back to a colour
             font entirely. These also actually depict the thing - a fleet is ships in formation,
             intel is a scan, a ping is a broadcast. -->
        <PathGeometry x:Key="IconMain"   Figures="M3.5,3.5 H10 V10 H3.5 Z M14,3.5 H20.5 V10 H14 Z M3.5,14 H10 V20.5 H3.5 Z M14,14 H20.5 V20.5 H14 Z"/>
        <PathGeometry x:Key="IconFleet"  Figures="M12,1.8 L17.4,11.6 H6.6 Z M5.4,13 L9.6,21.4 H1.2 Z M18.6,13 L22.8,21.4 H14.4 Z"/>
        <PathGeometry x:Key="IconIntel"  Figures="M12,3 A9,9 0 1,1 11.9,3 Z M12,7.5 A4.5,4.5 0 1,1 11.95,7.5 Z M12,12 L18.4,7.5"/>
        <PathGeometry x:Key="IconPing"   Figures="M12,10.6 A1.4,1.4 0 1,1 11.99,10.6 Z M8,7.4 A6,6 0 0,0 8,15.8 M16,7.4 A6,6 0 0,1 16,15.8 M4.9,4.3 A10.4,10.4 0 0,0 4.9,18.9 M19.1,4.3 A10.4,10.4 0 0,1 19.1,18.9"/>
        <PathGeometry x:Key="IconAlerts" Figures="M12,3.2 L21.6,19.8 H2.4 Z M12,9.6 V14.4 M12,17.4 V17.5"/>
        <PathGeometry x:Key="IconSetup"  Figures="M19.06,9.77 L22.05,10.23 L22.05,13.77 L19.06,14.23 L18.56,15.42 L20.36,17.85 L17.85,20.36 L15.42,18.56 L14.23,19.06 L13.77,22.05 L10.23,22.05 L9.77,19.06 L8.58,18.56 L6.15,20.36 L3.64,17.85 L5.44,15.42 L4.94,14.23 L1.95,13.77 L1.95,10.23 L4.94,9.77 L5.44,8.58 L3.64,6.15 L6.15,3.64 L8.58,5.44 L9.77,4.94 L10.23,1.95 L13.77,1.95 L14.23,4.94 L15.42,5.44 L17.85,3.64 L20.36,6.15 L18.56,8.58 Z M12,8.6 A3.4,3.4 0 1,1 11.99,8.6 Z"/>

        <!-- Icons used on buttons. Same grid and weight as the rail set. Typographic marks
             (x, +, arrows) deliberately stay as text - they are punctuation, not iconography,
             and they set on the label's own baseline. -->
        <PathGeometry x:Key="IconOverlay"    Figures="M3.4,4.6 H14.6 V13.4 H3.4 Z M9.4,10.6 H20.6 V19.4 H9.4 Z"/>
        <PathGeometry x:Key="IconLockOpen"   Figures="M5.4,11 H18.6 V21 H5.4 Z M8.6,11 V7.7 A3.4,3.4 0 0,1 15.4,7.7"/>
        <PathGeometry x:Key="IconLockShut"   Figures="M5.4,11 H18.6 V21 H5.4 Z M8.6,11 V7.7 A3.4,3.4 0 0,1 15.4,7.7 V11"/>
        <PathGeometry x:Key="IconDemo"       Figures="M9.5,2.8 V9.4 L4.3,18.9 A1.5,1.5 0 0,0 5.6,21.2 H18.4 A1.5,1.5 0 0,0 19.7,18.9 L14.5,9.4 V2.8 M8.2,2.8 H15.8 M7.2,14.6 H16.8"/>
        <PathGeometry x:Key="IconReport"     Figures="M5.6,2.8 H14.4 L18.4,6.8 V21.2 H5.6 Z M14.4,2.8 V6.8 H18.4 M8.6,11.6 H15.4 M8.6,15.2 H15.4 M8.6,18.8 H12.6"/>
        <PathGeometry x:Key="IconRefresh"    Figures="M19.6,7.8 A8.6,8.6 0 1,0 20.6,13.8 M19.6,7.8 V3.4 M19.6,7.8 H15.2"/>
        <PathGeometry x:Key="IconShield"     Figures="M12,2.2 L20.4,5.6 V11.8 Q20.4,18.2 12,21.8 Q3.6,18.2 3.6,11.8 V5.6 Z M8.4,11.8 L11.2,14.6 L16,9.4"/>
        <PathGeometry x:Key="IconTarget"     Figures="M12,3.4 A8.6,8.6 0 1,1 11.99,3.4 Z M12,1.5 V6.3 M12,17.7 V22.5 M1.5,12 H6.3 M17.7,12 H22.5 M12,12 V12.01"/>
        <PathGeometry x:Key="IconBoost"      Figures="M13.4,2.4 L5.2,13.4 H11.2 L10.6,21.6 L18.8,10.6 H12.8 Z"/>
        <PathGeometry x:Key="IconMove"       Figures="M3.4,8.6 H20.6 M16.8,4.8 L20.6,8.6 L16.8,12.4 M20.6,15.4 H3.4 M7.2,11.6 L3.4,15.4 L7.2,19.2"/>
        <PathGeometry x:Key="IconEdit"       Figures="M16.4,3.2 L20.8,7.6 L8.4,20 L3.2,21.4 L4.6,16.2 Z M14.2,5.4 L18.6,9.8"/>
        <PathGeometry x:Key="IconPlay"       Figures="M7.4,3.6 L20.4,12 L7.4,20.4 Z"/>

        <PathGeometry x:Key="IconDragDots"   Figures="M9,6.6 V6.61 M15,6.6 V6.61 M9,12 V12.01 M15,12 V12.01 M9,17.4 V17.41 M15,17.4 V17.41"/>

        <!-- Outline icons, so Stroke carries the colour and Fill stays empty. The rail button's
             triggers recolour its Foreground, which a Path does not inherit the way a TextBlock
             does, so bind to the owning button rather than relying on inheritance. -->
        <Style x:Key="NavRailIcon" TargetType="Path">
            <Setter Property="Width"               Value="22"/>
            <Setter Property="Height"              Value="22"/>
            <Setter Property="Stretch"             Value="Uniform"/>
            <Setter Property="StrokeThickness"     Value="1.5"/>
            <Setter Property="StrokeLineJoin"      Value="Round"/>
            <Setter Property="StrokeStartLineCap"  Value="Round"/>
            <Setter Property="StrokeEndLineCap"    Value="Round"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment"   Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Stroke"
                    Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
        </Style>

        <!-- Button-sized icon. Same contract as NavRailIcon: outline only, colour off the
             owning button so the button's own triggers drive it. -->
        <Style x:Key="ButtonIcon" TargetType="Path">
            <Setter Property="Width"               Value="14"/>
            <Setter Property="Height"              Value="14"/>
            <Setter Property="Stretch"             Value="Uniform"/>
            <Setter Property="StrokeThickness"     Value="1.7"/>
            <Setter Property="StrokeLineJoin"      Value="Round"/>
            <Setter Property="StrokeStartLineCap"  Value="Round"/>
            <Setter Property="StrokeEndLineCap"    Value="Round"/>
            <Setter Property="VerticalAlignment"   Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Stroke"
                    Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
        </Style>

        <!-- BUTTON GLYPH - the small symbol before a button's label. Kept as its own TextBlock
             rather than baked into the label string: these glyphs fall back to a different font,
             so inline they arrive at a different weight and sit off the label's baseline. -->
        <Style x:Key="ButtonGlyph" TargetType="TextBlock">
            <Setter Property="FontSize"          Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin"            Value="0,0,7,0"/>
            <Setter Property="Opacity"           Value="0.85"/>
        </Style>

        <!-- PAGE TITLE - big light-weight heading, matches the dashboard greeting -->
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource EveTextPrimary}"/>
            <Setter Property="FontFamily" Value="{StaticResource FontUI}"/>
            <Setter Property="FontSize"   Value="26"/>
            <Setter Property="FontWeight" Value="Light"/>
        </Style>

        <!-- PAGE EYEBROW - uppercase category above the title -->
        <Style x:Key="PageEyebrow" TargetType="TextBlock" BasedOn="{StaticResource SectionLabel}">
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- SLIM SCROLLBAR -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border CornerRadius="4" Background="#3a3a54" Margin="2,0"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DARK COMBOBOX -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource EveTextPrimary}"/>
            <Setter Property="FontFamily" Value="{StaticResource FontUI}"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Padding"    Value="10,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="4">
                            <ContentPresenter TextElement.Foreground="{StaticResource EveTextPrimary}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#211d34"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource EveTextPrimary}"/>
            <Setter Property="FontFamily" Value="{StaticResource FontUI}"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Height"     Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="26"/>
                            </Grid.ColumnDefinitions>
                            <!-- Full-width background + open-on-click (sits behind everything) -->
                            <ToggleButton Grid.ColumnSpan="2" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="bd" Background="#15151f" BorderBrush="{DynamicResource EveHairlineStrong}"
                                                BorderThickness="1" CornerRadius="7"/>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource EveAccent}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <!-- Selected item (non-editable) -->
                            <ContentPresenter x:Name="contentPresenter" Grid.Column="0" IsHitTestVisible="False"
                                              Margin="11,0,0,0" VerticalAlignment="Center"
                                              TextElement.Foreground="{StaticResource EveTextPrimary}"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                            <!-- Editable text entry (shown only when IsEditable) -->
                            <TextBox x:Name="PART_EditableTextBox" Grid.Column="0" Visibility="Collapsed"
                                     Margin="8,0,0,0" VerticalAlignment="Center" VerticalContentAlignment="Center"
                                     Background="Transparent" BorderThickness="0" Padding="0"
                                     Foreground="{StaticResource EveTextPrimary}" CaretBrush="{DynamicResource EveAccent}"/>
                            <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                                  Data="M 0 0 L 8 0 L 4 5 Z" Fill="{StaticResource EveTextSecondary}"/>
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border Background="#15151f" BorderBrush="{DynamicResource EveHairlineStrong}" BorderThickness="1"
                                        CornerRadius="7" Margin="0,2,0,0" Padding="3"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer><ItemsPresenter/></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="contentPresenter"     Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- PAGE -> VIEW MAPPINGS -->
        <DataTemplate DataType="{x:Type vm:LoginViewModel}">
            <views:LoginView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MenuViewModel}">
            <views:MenuView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:IntelViewModel}">
            <views:IntelView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FleetViewModel}">
            <views:FleetView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SessionLogViewModel}">
            <views:SessionLogView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PingViewModel}">
            <views:PingView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AlertsViewModel}">
            <views:AlertsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AccountViewModel}">
            <views:AccountView/>
        </DataTemplate>

        <!-- Themed right-click menus (dark HUD, applied app-wide) -->
        <Style TargetType="ContextMenu">
            <Setter Property="Background"      Value="{DynamicResource EvePanelBg}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource EveHairlineStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ItemsPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Foreground"  Value="{StaticResource EveTextSecondary}"/>
            <Setter Property="Background"  Value="Transparent"/>
            <Setter Property="Padding"     Value="10,6"/>
            <Setter Property="FontFamily"  Value="{StaticResource FontUI}"/>
            <Setter Property="FontSize"    Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource EveRaisedBg}"/>
                                <Setter Property="Foreground" Value="{StaticResource EveTextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource EveTextDim}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Menus look up their separators by this key -->
        <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
            <Setter Property="Margin" Value="6,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Rectangle Height="1" Fill="{DynamicResource EveHairline}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Themed tooltips app-wide (plain string tooltips; the rich card tooltips set their own). -->
        <Style TargetType="ToolTip">
            <Setter Property="Background"      Value="{DynamicResource EvePanelBg}"/>
            <Setter Property="Foreground"      Value="{StaticResource EveTextSecondary}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource EveHairlineStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="9,5"/>
            <Setter Property="FontFamily"      Value="{StaticResource FontUI}"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Application.Resources>
</Application>
